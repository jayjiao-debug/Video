    },
    {
      "name": "F2",
      "lang": "de",
      "text": "Er begreift: Die Liebe ist das Höchste, wonach ein Mensch streben kann.",
      "voice": "shared:Otto - Casual and Normal (standard, de)",
      "voice_id": "FTNCalFNG5bRnkkaP5Ug",
      "model": "eleven_v4",
      "status": 200,
      "file": "F2.mp3",
      "bytes": 80291,
      "heard": "Er begreift, die Liebe ist das Höchste, wonach ein Mensch streben kann.",
