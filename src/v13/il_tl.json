 ],
 "fps": 30,
 "hit": 16.489,
 "bgm_offset": 0.111,
 "drop2": 75.258,
 "vo_end": 123.447,
 "film_end": 128.411,
 "segments": [
  {
   "id": "O1",
   "block": "O",
   "caption": "打游戏，一抬头天亮了；",
   "t0": 0.35,
   "t1": 1.855
  },
  {
   "id": "O2",
   "block": "O",
   "caption": "写作业，十分钟像一小时。",
   "t0": 2.005,
   "t1": 3.729
  },
  {
   "id": "O3",
   "block": "O",
   "caption": "同一个你，同一个脑子。",
   "t0": 4.299,
   "t1": 5.969
  },
  {
   "id": "O4",
   "block": "O",
   "caption": "差别不在你懒，在事情本身怎么设计。",
   "t0": 6.189,
   "t1": 8.669
  },
  {
   "id": "O5",
   "block": "O",
   "caption": "心理学家研究了几十年，找出了让人停不下来的三个条件。",
   "t0": 8.989,
   "t1": 12.669
  },
  {
   "id": "O6",
   "block": "O",
   "caption": "看完这两分钟，你可以把它装进任何一件事里。",
   "t0": 12.889,
   "t1": 15.789
  },
  {
   "id": "T1",
   "block": "T",
   "caption": "心流。",
   "t0": 16.539,
   "t1": 17.02
  },
  {
   "id": "P1",
   "block": "P",
   "caption": "上世纪六十年代，心理学家契克森米哈赖注意到一件怪事：",
   "t0": 18.07,
   "t1": 21.795
  },
  {
   "id": "P2",
   "block": "P",
   "caption": "画家画得顺的时候，饿了累了都不管；",
   "t0": 21.795,
   "t1": 24.105
  },
  {
   "id": "P3",
   "block": "P",
   "caption": "可一画完，马上就没兴趣了。",
   "t0": 24.105,
   "t1": 26.097
  },
  {
   "id": "P4",
   "block": "P",
   "caption": "他们要的不是那幅画，是画画的过程。",
   "t0": 26.317,
   "t1": 29.027
  },
  {
   "id": "P5",
   "block": "P",
   "caption": "他又去问下棋的、攀岩的、跳舞的人，",
   "t0": 29.447,
   "t1": 31.872
  },
  {
   "id": "P6",
   "block": "P",
   "caption": "答案出奇地一致：像被一股水流带着走。",
   "t0": 31.872,
   "t1": 34.505
  },
  {
   "id": "K1",
   "block": "K",
   "caption": "心流有三个条件。游戏全做到了，作业几乎一个没有。",
   "t0": 35.255,
   "t1": 39.062
  },
  {
   "id": "K2",
   "block": "K",
   "caption": "第一，目标清楚。",
   "t0": 39.482,
   "t1": 40.842
  },
  {
   "id": "K3",
   "block": "K",
   "caption": "游戏说：打败这只怪。",
   "t0": 41.062,
   "t1": 42.8
  },
  {
   "id": "K4",
   "block": "K",
   "caption": "作业说：复习第三章——复习到哪算完？",
   "t0": 43.02,
   "t1": 45.838
  },
  {
   "id": "K5",
   "block": "K",
   "caption": "不知道终点，人就使不上劲。",
   "t0": 46.058,
   "t1": 48.218
  },
  {
   "id": "K6",
   "block": "K",
   "caption": "第二，马上反馈。",
   "t0": 48.738,
   "t1": 50.308
  },
  {
   "id": "K7",
   "block": "K",
   "caption": "游戏每打一下，都有数字跳出来；",
   "t0": 50.528,
   "t1": 52.958
  },
  {
   "id": "K8",
   "block": "K",
   "caption": "作业要等一周才发卷子。",
   "t0": 52.958,
   "t1": 54.489
  },
  {
   "id": "K9",
   "block": "K",
   "caption": "不知道对不对，只能硬撑。",
   "t0": 54.709,
   "t1": 56.67
  },
  {
   "id": "K10",
   "block": "K",
   "caption": "第三，难度刚好。",
   "t0": 57.19,
   "t1": 58.56
  },
  {
   "id": "K11",
   "block": "K",
   "caption": "太难，会焦虑；",
   "t0": 58.78,
   "t1": 59.665
  },
  {
   "id": "K12",
   "block": "K",
   "caption": "太简单，会无聊；",
   "t0": 60.665,
   "t1": 61.69
  },
  {
   "id": "K13",
   "block": "K",
   "caption": "要踮一下脚才够得着，人才进得去。",
   "t0": 62.24,
   "t1": 64.696
  },
  {
   "id": "M1",
   "block": "M",
   "caption": "那刚好到底是多难？",
   "t0": 65.646,
   "t1": 66.924
  },
  {
   "id": "M2",
   "block": "M",
   "caption": "2019年，几位科学家造了一个会学习的程序，",
   "t0": 67.144,
   "t1": 70.429
  },
  {
   "id": "M3",
   "block": "M",
   "caption": "让它练题，再一点点调难度，看什么时候学得最快。",
   "t0": 70.429,
   "t1": 73.984
  },
  {
   "id": "M4",
   "block": "M",
   "caption": "答案是：答对85%左右。",
   "t0": 75.008,
   "t1": 77.064
  },
  {
   "id": "M5",
   "block": "M",
   "caption": "全对，说明没学到新东西；",
   "t0": 77.284,
   "t1": 79.094
  },
  {
   "id": "M6",
   "block": "M",
   "caption": "只对一半，跟瞎猜差不多。",
   "t0": 79.094,
   "t1": 81.134
  },
  {
   "id": "M7",
   "block": "M",
   "caption": "它和心流说的是同一件事：错一点，才是在学。",
   "t0": 81.354,
   "t1": 84.627
  },
  {
   "id": "W1",
   "block": "W",
   "caption": "更反直觉的是：人在上班时，比下班更容易进入心流。",
   "t0": 85.427,
   "t1": 89.177
  },
  {
   "id": "W2",
   "block": "W",
   "caption": "研究者想知道人每时每刻的真实感受，事后回忆不准，",
   "t0": 89.397,
   "t1": 92.992
  },
  {
   "id": "W3",
   "block": "W",
   "caption": "于是给芝加哥78个上班族发了传呼机，",
   "t0": 92.992,
   "t1": 95.889
  },
  {
   "id": "W4",
   "block": "W",
   "caption": "一周随机响50多次，每响一次就当场记下：在干嘛，难不难，会不会。",
   "t0": 95.889,
   "t1": 100.315
  },
  {
   "id": "W5",
   "block": "W",
   "caption": "结果，上班时54%的时刻在心流里，",
   "t0": 100.535,
   "t1": 103.371
  },
  {
   "id": "W6",
   "block": "W",
   "caption": "下班后只有17%。",
   "t0": 103.371,
   "t1": 104.986
  },
  {
   "id": "W7",
   "block": "W",
   "caption": "下班我们常做的是看电视：很放松，可没有目标，也没有挑战。",
   "t0": 105.206,
   "t1": 109.257
  },
  {
   "id": "E1",
   "block": "E",
   "caption": "所以，心流不靠意志力，靠设计。",
   "t0": 110.157,
   "t1": 112.25
  },
  {
   "id": "E2",
   "block": "E",
   "caption": "下次写作业，把它改成游戏：",
   "t0": 112.47,
   "t1": 114.635
  },
  {
   "id": "E3",
   "block": "E",
   "caption": "把“复习第三章”，拆成“先做完这5道题”；",
   "t0": 114.635,
   "t1": 117.265
  },
  {
   "id": "E4",
   "block": "E",
   "caption": "做完马上对答案；",
   "t0": 117.265,
   "t1": 118.57
  },
  {
   "id": "E5",
   "block": "E",
   "caption": "挑你大概会错一两成的题。",
   "t0": 118.57,
   "t1": 120.388
  },
  {
   "id": "E6",
   "block": "E",
   "caption": "你最近一次忘了时间，是在做什么？",
   "t0": 121.058,
   "t1": 123.447
  }
 ],
