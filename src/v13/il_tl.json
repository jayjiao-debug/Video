 ],
 "fps": 30,
 "hit": 17.497,
 "bgm_offset": -0.897,
 "drop2": 78.286,
 "vo_end": 128.787,
 "film_end": 133.483,
 "segments": [
  {
   "id": "O1",
   "block": "O",
   "caption": "打游戏，一抬头天亮了；",
   "t0": 0.0,
   "t1": 1.645
  },
  {
   "id": "O2",
   "block": "O",
   "caption": "写作业，十分钟像一小时。",
   "t0": 1.795,
   "t1": 3.71
  },
  {
   "id": "O3",
   "block": "O",
   "caption": "同一个你，同一个脑子。",
   "t0": 4.28,
   "t1": 6.078
  },
  {
   "id": "O4",
   "block": "O",
   "caption": "差别不在你懒，在事情本身怎么设计。",
   "t0": 6.298,
   "t1": 8.968
  },
  {
   "id": "O5",
   "block": "O",
   "caption": "心理学家找出了让人停不下来的三个条件。",
   "t0": 9.288,
   "t1": 11.808
  },
  {
   "id": "O6",
   "block": "O",
   "caption": "看完这两分钟，你可以把它装进任何一件事里。",
   "t0": 12.028,
   "t1": 15.098
  },
  {
   "id": "T1",
   "block": "T",
   "caption": "这种忘了时间的状态，叫心流。",
   "t0": 15.848,
   "t1": 17.998
  },
  {
   "id": "P1",
   "block": "P",
   "caption": "六十年代，心理学家契克森米哈赖发现一件怪事：",
   "t0": 19.048,
   "t1": 22.428
  },
  {
   "id": "P2",
   "block": "P",
   "caption": "画家画得顺的时候，饿了累了都不管；",
   "t0": 22.428,
   "t1": 24.948
  },
  {
   "id": "P3",
   "block": "P",
   "caption": "可一画完，马上就没了兴趣。",
   "t0": 24.948,
   "t1": 26.978
  },
  {
   "id": "P4",
   "block": "P",
   "caption": "画家要的不是那幅画，是画画的过程。",
   "t0": 27.198,
   "t1": 30.048
  },
  {
   "id": "P5",
   "block": "P",
   "caption": "他又去问下棋的、攀岩的、跳舞的人，",
   "t0": 30.468,
   "t1": 33.043
  },
  {
   "id": "P6",
   "block": "P",
   "caption": "大家说的是同一种感觉：像被一股水流带着走。",
   "t0": 33.043,
   "t1": 36.398
  },
  {
   "id": "K1",
   "block": "K",
   "caption": "心流有三个条件。游戏全做到了，作业几乎一个没有。",
   "t0": 37.148,
   "t1": 40.878
  },
  {
   "id": "K2",
   "block": "K",
   "caption": "第一，目标清楚。",
   "t0": 41.298,
   "t1": 42.758
  },
  {
   "id": "K3",
   "block": "K",
   "caption": "游戏说：打败这只怪。",
   "t0": 42.978,
   "t1": 44.828
  },
  {
   "id": "K4",
   "block": "K",
   "caption": "作业说：复习第三章——复习到哪算完？",
   "t0": 45.048,
   "t1": 47.808
  },
  {
   "id": "K5",
   "block": "K",
   "caption": "不知道终点，人就使不上劲。",
   "t0": 48.028,
   "t1": 50.198
  },
  {
   "id": "K6",
   "block": "K",
   "caption": "第二，马上反馈。",
   "t0": 50.718,
   "t1": 52.038
  },
  {
   "id": "K7",
   "block": "K",
   "caption": "游戏每打一下，都有数字跳出来；",
   "t0": 52.258,
   "t1": 54.641
  },
  {
   "id": "K8",
   "block": "K",
   "caption": "作业要等一周才发卷子。",
   "t0": 54.641,
   "t1": 56.516
  },
  {
   "id": "K9",
   "block": "K",
   "caption": "不知道对不对，只能硬撑。",
   "t0": 56.736,
   "t1": 58.857
  },
  {
   "id": "K10",
   "block": "K",
   "caption": "第三，难度刚好。",
   "t0": 59.377,
   "t1": 60.857
  },
  {
   "id": "K11",
   "block": "K",
   "caption": "太难，会焦虑；",
   "t0": 61.077,
   "t1": 62.062
  },
  {
   "id": "K12",
   "block": "K",
   "caption": "太简单，会无聊；",
   "t0": 63.062,
   "t1": 64.132
  },
  {
   "id": "K13",
   "block": "K",
   "caption": "要踮一下脚才够得着，人才进得去。",
   "t0": 64.682,
   "t1": 67.227
  },
  {
   "id": "M1",
   "block": "M",
   "caption": "那刚好到底是多难？",
   "t0": 68.177,
   "t1": 69.587
  },
  {
   "id": "M2",
   "block": "M",
   "caption": "2019年，几位科学家造了一个会学习的程序，",
   "t0": 69.807,
   "t1": 73.287
  },
  {
   "id": "M3",
   "block": "M",
   "caption": "让它练题，再一点点调难度，看什么时候学得最快。",
   "t0": 73.287,
   "t1": 77.177
  },
  {
   "id": "M4",
   "block": "M",
   "caption": "答案是：答对85%左右。",
   "t0": 78.036,
   "t1": 80.276
  },
  {
   "id": "M5",
   "block": "M",
   "caption": "全对，说明没学到新东西；",
   "t0": 80.496,
   "t1": 82.576
  },
  {
   "id": "M6",
   "block": "M",
   "caption": "只对一半，跟瞎猜差不多。",
   "t0": 82.576,
   "t1": 84.756
  },
  {
   "id": "M7",
   "block": "M",
   "caption": "作者猜，这就是心流说的“刚好”，只是还没在人身上试过。",
   "t0": 84.976,
   "t1": 88.706
  },
  {
   "id": "W1",
   "block": "W",
   "caption": "更反直觉的是：人在上班时，比下班更容易进入心流。",
   "t0": 89.506,
   "t1": 93.336
  },
  {
   "id": "W2",
   "block": "W",
   "caption": "研究者想知道人每时每刻的真实感受，事后回忆靠不住，",
   "t0": 93.556,
   "t1": 97.491
  },
  {
   "id": "W3",
   "block": "W",
   "caption": "于是给芝加哥78个上班族发了传呼机，",
   "t0": 97.491,
   "t1": 100.411
  },
  {
   "id": "W4",
   "block": "W",
   "caption": "一周随机响50多次，每响一次就当场记下：在干嘛，难不难，会不会。",
   "t0": 100.411,
   "t1": 105.226
  },
  {
   "id": "W5",
   "block": "W",
   "caption": "上班时，54%的时刻在心流里；",
   "t0": 105.446,
   "t1": 108.229
  },
  {
   "id": "W6",
   "block": "W",
   "caption": "下班后只有17%。",
   "t0": 108.229,
   "t1": 110.016
  },
  {
   "id": "W7",
   "block": "W",
   "caption": "下班我们常做的是看电视：很放松，但很被动。",
   "t0": 110.236,
   "t1": 113.459
  },
  {
   "id": "E1",
   "block": "E",
   "caption": "所以，心流不靠意志力，靠设计。",
   "t0": 114.359,
   "t1": 116.589
  },
  {
   "id": "E2",
   "block": "E",
   "caption": "下次写作业，把它改成游戏：",
   "t0": 116.809,
   "t1": 119.224
  },
  {
   "id": "E3",
   "block": "E",
   "caption": "把“复习第三章”，拆成“先做完这5道题”；",
   "t0": 119.224,
   "t1": 122.089
  },
  {
   "id": "E4",
   "block": "E",
   "caption": "做完马上对答案；",
   "t0": 122.089,
   "t1": 123.594
  },
  {
   "id": "E5",
   "block": "E",
   "caption": "挑你大概会错一两成的题。",
   "t0": 123.594,
   "t1": 125.579
  },
  {
   "id": "E6",
   "block": "E",
   "caption": "你最近一次忘了时间，是在做什么？",
   "t0": 126.249,
   "t1": 128.787
  }
 ],
