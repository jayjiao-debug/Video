{
 "fps": 30,
 "hit": 13.47,
 "bgm_offset": 3.13,
 "drop2": 78.3,
 "vo_end": 116.854,
 "film_end": 121.84,
 "segments": [
  {
   "id": "B1",
   "block": "B",
   "caption": "同一个脑子，为什么差这么多？",
   "t0": 6.47,
   "t1": 8.54
  },
  {
   "id": "B2",
   "block": "B",
   "caption": "2019年，几位科学家用一个学习模型算出：",
   "t0": 8.89,
   "t1": 11.895
  },
  {
   "id": "B3",
   "block": "B",
   "caption": "练习时，答对85%左右，",
   "t0": 11.895,
   "t1": 14.17
  },
  {
   "id": "B4",
   "block": "B",
   "caption": "学得最快。",
   "t0": 14.17,
   "t1": 15.041
  },
  {
   "id": "B5",
   "block": "B",
   "caption": "而这个点，藏在一种你一定有过的状态里——",
   "t0": 15.891,
   "t1": 18.551
  },
  {
   "id": "T1",
   "block": "B",
   "caption": "心流。",
   "t0": 18.551,
   "t1": 18.871
  },
  {
   "id": "C1",
   "block": "C",
   "caption": "心理学家契克森米哈赖，问过下棋的、攀岩的、跳舞的人：",
   "t0": 20.771,
   "t1": 24.581
  },
  {
   "id": "C2",
   "block": "C",
   "caption": "最投入的时候，是什么感觉？",
   "t0": 24.581,
   "t1": 26.754
  },
  {
   "id": "C3",
   "block": "C",
   "caption": "他们说的是同一种感觉：像被一股水流带着走。",
   "t0": 27.054,
   "t1": 29.892
  },
  {
   "id": "D1",
   "block": "D",
   "caption": "游戏为什么这么容易让人进去？",
   "t0": 30.892,
   "t1": 32.862
  },
  {
   "id": "D2",
   "block": "D",
   "caption": "因为它偷偷做对了三件事。",
   "t0": 33.162,
   "t1": 34.826
  },
  {
   "id": "D3",
   "block": "D",
   "caption": "第一，目标清楚。",
   "t0": 35.376,
   "t1": 36.736
  },
  {
   "id": "D4",
   "block": "D",
   "caption": "任务栏写着：击败Boss，",
   "t0": 37.036,
   "t1": 38.876
  },
  {
   "id": "D5",
   "block": "D",
   "caption": "你永远知道下一步干嘛。",
   "t0": 38.876,
   "t1": 40.326
  },
  {
   "id": "D6",
   "block": "D",
   "caption": "作业呢？",
   "t0": 40.726,
   "t1": 41.365
  },
  {
   "id": "D7",
   "block": "D",
   "caption": "“复习第三章”——复习到哪算完？",
   "t0": 41.665,
   "t1": 43.68
  },
  {
   "id": "D8",
   "block": "D",
   "caption": "第二，马上反馈。",
   "t0": 44.43,
   "t1": 46.006
  },
  {
   "id": "D9",
   "block": "D",
   "caption": "每一下都有伤害数字、经验条、升级的声音。",
   "t0": 46.306,
   "t1": 49.246
  },
  {
   "id": "D10",
   "block": "D",
   "caption": "作业的反馈，要等到下周发卷子。",
   "t0": 49.546,
   "t1": 51.836
  },
  {
   "id": "D11",
   "block": "D",
   "caption": "第三，难度刚好。",
   "t0": 52.586,
   "t1": 53.956
  },
  {
   "id": "D12",
   "block": "D",
   "caption": "太难，会焦虑；",
   "t0": 54.256,
   "t1": 55.146
  },
  {
   "id": "D13",
   "block": "D",
   "caption": "太简单，会无聊；",
   "t0": 56.746,
   "t1": 57.811
  },
  {
   "id": "D14",
   "block": "D",
   "caption": "刚好够你够一下，才进得去。",
   "t0": 58.361,
   "t1": 60.567
  },
  {
   "id": "E1",
   "block": "E",
   "caption": "把它画出来：横轴是能力，纵轴是挑战，",
   "t0": 62.367,
   "t1": 65.352
  },
  {
   "id": "E2",
   "block": "E",
   "caption": "中间这条斜斜的通道，就是心流。",
   "t0": 65.352,
   "t1": 67.807
  },
  {
   "id": "E3",
   "block": "E",
   "caption": "你变强了，挑战也得跟着涨，",
   "t0": 68.107,
   "t1": 69.982
  },
  {
   "id": "E4",
   "block": "E",
   "caption": "所以游戏要分关卡。",
   "t0": 69.982,
   "t1": 71.254
  },
  {
   "id": "E5",
   "block": "E",
   "caption": "那篇85%的论文里，作者也提到了游戏关卡，",
   "t0": 71.854,
   "t1": 75.024
  },
  {
   "id": "E6",
   "block": "E",
   "caption": "还猜：心流，可能就是学得最快的地方。",
   "t0": 75.024,
   "t1": 77.559
  },
  {
   "id": "F1",
   "block": "F",
   "caption": "心流只在游戏里吗？",
   "t0": 78.35,
   "t1": 79.641
  },
  {
   "id": "F2",
   "block": "F",
   "caption": "研究者给芝加哥78个上班族发了传呼机，",
   "t0": 79.941,
   "t1": 82.796
  },
  {
   "id": "F3",
   "block": "F",
   "caption": "一周随机响50多次。",
   "t0": 82.796,
   "t1": 84.241
  },
  {
   "id": "F4",
   "block": "F",
   "caption": "每响一次，就记下：在干嘛，难不难，会不会。",
   "t0": 84.541,
   "t1": 87.353
  },
  {
   "id": "F5",
   "block": "F",
   "caption": "结果：上班时，54%的时刻在心流里；",
   "t0": 87.653,
   "t1": 90.849
  },
  {
   "id": "F6",
   "block": "F",
   "caption": "下班后，只有17%。",
   "t0": 90.849,
   "t1": 92.673
  },
  {
   "id": "F7",
   "block": "F",
   "caption": "可上班时，他们反而更想去做点别的。",
   "t0": 92.973,
   "t1": 95.541
  },
  {
   "id": "F8",
   "block": "F",
   "caption": "下班后最常做的，是看电视：",
   "t0": 95.841,
   "t1": 97.801
  },
  {
   "id": "F9",
   "block": "F",
   "caption": "很放松，却也很被动。",
   "t0": 97.801,
   "t1": 99.601
  },
  {
   "id": "G1",
   "block": "G",
   "caption": "所以，心流不在躺平里，",
   "t0": 100.901,
   "t1": 102.786
  },
  {
   "id": "G2",
   "block": "G",
   "caption": "也不在硬撑里，",
   "t0": 102.786,
   "t1": 103.856
  },
  {
   "id": "G3",
   "block": "G",
   "caption": "在一件刚刚好难的事里。",
   "t0": 103.856,
   "t1": 105.281
  },
  {
   "id": "G4",
   "block": "G",
   "caption": "下次写作业，把它改成游戏：",
   "t0": 105.931,
   "t1": 108.091
  },
  {
   "id": "G5",
   "block": "G",
   "caption": "拆成一关一关，每关写清目标；",
   "t0": 108.091,
   "t1": 110.486
  },
  {
   "id": "G6",
   "block": "G",
   "caption": "做完马上对答案；",
   "t0": 110.486,
   "t1": 111.801
  },
  {
   "id": "G7",
   "block": "G",
   "caption": "挑你大概会错一两成的题。",
   "t0": 111.801,
   "t1": 113.618
  },
  {
   "id": "G8",
   "block": "G",
   "caption": "你最近一次忘了时间，是在做什么？",
   "t0": 114.468,
   "t1": 116.854
  }
 ],
