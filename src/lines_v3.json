[[0.6, 2.9857142857142858, "路边一只猫被车撞了"], [3.105714285714286, 5.491428571428571, "很多人会难过一整天"], [5.611428571428571, 7.854285714285714, "2018年，肯尼亚"], [7.974285714285714, 11.36, "世界上最后一只雄性北方白犀牛死了"], [11.479999999999999, 13.579999999999998, "它叫苏丹，45岁"], [13.699999999999998, 15.94285714285714, "全世界都为它难过"], [17.0, 19.385714285714286, "一只苍蝇落在窗台上"], [19.6, 22.12857142857143, "一巴掌，没人会多看一眼"], [22.6, 24.5, "苍蝇、猫、犀牛"], [25.0, 26.9, "都是一条命"], [27.6, 30.414285714285715, "为什么心疼的程度，差这么多"], [31.0, 32.957142857142856, "是我们太冷漠"], [33.4, 35.92857142857143, "还是有些命，天生就更重"], [36.6, 39.55714285714286, "人类为这个问题，争了两千多年"], [47.2, 49.871428571428574, "法国研究者问了三千多人"], [49.99142857142857, 52.94857142857143, "52种生物，只能救一个，你救谁"], [53.068571428571424, 55.311428571428564, "答案排成了一条线"], [55.43142857142856, 57.81714285714285, "和人类越近，越被同情"], [57.937142857142845, 60.32285714285713, "我们心里有一把尺子"], [60.44285714285713, 62.68571428571427, "刻度是：[像不像我们]"], [63.2, 65.72857142857143, "庄子和惠子在桥上看鱼"], [65.84857142857143, 67.94857142857143, "庄子说：鱼真快乐"], [68.06857142857143, 71.16857142857143, "惠子问：{你不是鱼}，怎么知道鱼快乐"], [71.28857142857143, 75.10285714285715, "1974年，内格尔问：做一只蝙蝠是什么感觉"], [75.22285714285715, 78.03714285714287, "我们永远进不到别的生命里"], [78.15714285714287, 81.11428571428573, "只能用\"像不像我\"，去猜它疼不疼"], [81.23428571428573, 83.76285714285716, "那么，这条线该画在哪里"], [83.9, 86.0, "康德说：画在[理性]"], [86.12, 89.07714285714286, "只有会思考的人，才是目的本身"], [89.19714285714286, 92.01142857142858, "对动物，我们没有直接的义务"], [92.13142857142859, 94.66000000000001, "可他也说：虐待动物的人"], [94.78000000000002, 97.02285714285716, "对人，也会变得冷酷"], [97.14285714285717, 99.24285714285716, "边沁说：画在[痛苦]"], [99.36285714285717, 102.74857142857145, "问题不是它们能不能思考，能不能说话"], [102.86857142857146, 105.25428571428574, "而是：它们会不会痛苦"], [105.37428571428575, 108.47428571428574, "1975年，辛格在《动物解放》里说"], [108.59428571428575, 111.5514285714286, "同样的痛苦，就该被同样地在乎"], [111.6714285714286, 114.7714285714286, "一只鸡的痛，和一只狗的痛，一样重"], [114.8914285714286, 117.42000000000003, "只因为不是人，就不算数"], [117.54000000000003, 119.64000000000003, "这叫作{物种歧视}"], [119.76000000000003, 122.57428571428575, "就像种族歧视、性别歧视一样"], [122.69428571428575, 125.22285714285718, "史怀哲说：画在[生命本身]"], [125.6, 128.98571428571427, "一百多年前，非洲河上，船穿过一群河马"], [129.10571428571427, 131.6342857142857, "他想到四个字：敬畏生命"], [131.75428571428571, 134.14, "我是想活下去的生命"], [134.26, 137.21714285714285, "活在同样想活下去的生命之中"], [137.33714285714285, 139.72285714285712, "他拒绝给生命排高低"], [139.84285714285713, 141.94285714285712, "活着，免不了伤害"], [142.06285714285713, 144.16285714285712, "但不该{毫无必要}"], [146.4, 148.78571428571428, "1869年，莱基写道"], [148.90571428571428, 151.43428571428572, "人的善意，最先只给家人"], [151.55428571428573, 154.08285714285716, "后来是阶层、国家、全人类"], [154.20285714285717, 156.30285714285716, "最后，才轮到动物"], [157.6, 159.7, "所以，生命平等吗"], [160.0, 162.81428571428572, "在我们的感觉里，从来不平等"], [163.2, 166.15714285714284, "我们总以为，自己站在圈的中心"], [167.2, 169.58571428571426, "但这个圈，一直在变大"], [169.70571428571427, 171.9485714285714, "苏丹让全世界难过"], [172.0685714285714, 174.73999999999998, "不是因为它比苍蝇更值钱"], [174.85999999999999, 177.24571428571426, "是因为我们[看见了它]"], [177.36571428571426, 179.26571428571427, "庄子说"], [179.38571428571427, 182.34285714285713, "天地与我并生，而[万物与我为一]"]]