#!/bin/bash
# The Mac mini studio: one command for a film. Thin shim; the work is in studio.py (README.md next to this file).
#   studio setup | update | film <film> --ref <branch|sha> | voice <request.json> | gate | deliver | library | status
# Runs with the macOS default bash 3.2 as well as bash 5 (no associative arrays, no mapfile).
HERE="$(cd "$(dirname "$(readlink "$0" 2>/dev/null || echo "$0")")" && pwd)"
case "$HERE" in /*) ;; *) HERE="$(cd "$(dirname "$0")" && pwd)";; esac
export STUDIO_TOOLS="$(cd "$HERE/../.." && pwd)"
export STUDIO="${STUDIO:-$HOME/Claude/studio}"
# first found wins: ffmpeg-full (rubberband + drawtext), the studio's python (numpy, scipy, faster-whisper) as
# "python3", the studio's own node, its static ffmpeg, an old clone's portable node, then Homebrew and the system
FRONT=""
for d in /opt/homebrew/opt/ffmpeg-full/bin "$STUDIO/py/bin" "$STUDIO/node/bin" "$STUDIO/bin" \
         "$HOME/Claude/libai-render-test/node/bin" /opt/homebrew/bin /usr/local/bin; do
  [ -d "$d" ] && FRONT="$FRONT$d:"
done
PATH="$FRONT$PATH"
export PATH
PY="$STUDIO/py/bin/python3"
if [ ! -x "$PY" ]; then
  if [ "$1" != "setup" ]; then echo "studio: not set up yet. Run: bash $HERE/studio setup" >&2; exit 2; fi
  PY="$(command -v python3)" || { echo "studio: no python3 on this machine (install the Xcode command line tools: xcode-select --install)" >&2; exit 2; }
fi
exec "$PY" "$HERE/studio.py" "$@"
