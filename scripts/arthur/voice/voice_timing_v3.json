{
 "voice": "j",
 "rate": 5.5,
 "loudness": "-16 LUFS",
 "speech_end": 65.972,
 "lines": [
  {
   "line": 1,
   "take": "j01",
   "text": "他把刚拔出来的石中剑，又插了回去。",
   "start": 0.0,
   "end": 2.737,
   "tempo": 1.163,
   "rate": 5.48
  },
  {
   "line": 2,
   "take": "j02b",
   "text": "等等，拔出来不就是国王吗？",
   "start": 2.767,
   "end": 4.763,
   "tempo": 1.247,
   "rate": 5.51
  },
  {
   "line": 3,
   "take": "j03",
   "text": "名著《亚瑟王之死》里，伦敦教堂院子里多了块大石头，插着把剑。",
   "start": 4.867,
   "end": 9.428,
   "tempo": 1.248,
   "rate": 5.48
  },
  {
   "line": 4,
   "take": "j04",
   "text": "金字写着：谁拔出来，谁就是国王。",
   "start": 9.453,
   "end": 11.877,
   "tempo": 1.36,
   "rate": 5.36
  },
  {
   "line": 5,
   "take": "j05c",
   "text": "贵族排队来拔，脸都憋红了，剑一动不动。",
   "start": 11.909,
   "end": 14.986,
   "tempo": 1.36,
   "rate": 5.2
  },
  {
   "line": 6,
   "take": "j06",
   "text": "新年比武大会，亚瑟的哥哥叫凯，刚当上骑士，一摸腰，剑忘带了。",
   "start": 15.12,
   "end": 19.675,
   "tempo": 1.316,
   "rate": 5.49
  },
  {
   "line": 7,
   "take": "j07",
   "text": "亚瑟回去拿，家里没人，全看比武去了。",
   "start": 19.705,
   "end": 22.449,
   "tempo": 1.255,
   "rate": 5.47
  },
  {
   "line": 8,
   "take": "j08",
   "text": "他想起石头上还插着一把。",
   "start": 22.473,
   "end": 24.493,
   "tempo": 1.217,
   "rate": 5.45
  },
  {
   "line": 9,
   "take": "j09",
   "text": "连十个守卫都看比武去了，他一拔就出来，第一次。",
   "start": 24.513,
   "end": 28.074,
   "tempo": 1.08,
   "rate": 5.62
  },
  {
   "line": 10,
   "take": "j10",
   "text": "凯拿到剑就找爸爸：“爸，石中剑！我要当国王了！”",
   "start": 28.163,
   "end": 31.448,
   "tempo": 1.222,
   "rate": 5.48
  },
  {
   "line": 11,
   "take": "j11",
   "text": "爸爸让他发誓，凯才承认是弟弟拿的。",
   "start": 31.476,
   "end": 34.221,
   "tempo": 1.185,
   "rate": 5.46
  },
  {
   "line": 12,
   "take": "j12",
   "text": "爸爸让亚瑟插回去再拔一次，他说：“这有什么难的。”",
   "start": 34.243,
   "end": 37.896,
   "tempo": 1.149,
   "rate": 5.47
  },
  {
   "line": 13,
   "take": "j13",
   "text": "爸爸先拔，不动；凯使出吃奶的劲，不动；亚瑟一伸手，第二次。",
   "start": 37.92,
   "end": 42.11,
   "tempo": 1.298,
   "rate": 5.49
  },
  {
   "line": 14,
   "take": "j14",
   "text": "几天后贵族全来试，只有他拔得出，第三次。",
   "start": 42.242,
   "end": 45.339,
   "tempo": 1.36,
   "rate": 5.49
  },
  {
   "line": 15,
   "take": "j15b",
   "text": "他们气炸了：“让个出身不高的小子管我们？”说改天再拔。",
   "start": 45.375,
   "end": 49.382,
   "tempo": 1.2,
   "rate": 5.49
  },
  {
   "line": 16,
   "take": "j16b",
   "text": "二月，雪还没化，第四次，又拖。",
   "start": 49.475,
   "end": 52.15,
   "tempo": 1.36,
   "rate": 4.11
  },
  {
   "line": 17,
   "take": "j17",
   "text": "春天，花都开了，第五次，还拖。",
   "start": 52.185,
   "end": 54.939,
   "tempo": 1.36,
   "rate": 3.99
  },
  {
   "line": 18,
   "take": "j18b",
   "text": "初夏，当着所有人的面，第六次。",
   "start": 54.968,
   "end": 57.161,
   "tempo": 1.331,
   "rate": 5.47
  },
  {
   "line": 19,
   "take": "j19",
   "text": "老百姓急了：“就要亚瑟当国王，别再拖了！”",
   "start": 57.249,
   "end": 60.169,
   "tempo": 1.329,
   "rate": 5.48
  },
  {
   "line": 20,
   "take": "j20",
   "text": "所有人齐刷刷跪下。",
   "start": 60.199,
   "end": 61.653,
   "tempo": 1.316,
   "rate": 5.5
  },
  {
   "line": 21,
   "take": "j21",
   "text": "整整六次，他才当上国王，而第一次，只因为哥哥忘了带剑。",
   "start": 61.773,
   "end": 65.972,
   "tempo": 1.259,
   "rate": 5.48
  }
 ]
}