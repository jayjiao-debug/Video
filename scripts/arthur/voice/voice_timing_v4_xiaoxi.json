{
 "voice": "x",
 "rate": 5.5,
 "loudness": "-16 LUFS",
 "speech_end": 65.963,
 "lines": [
  {
   "line": 1,
   "take": "x01b",
   "text": "他把刚拔出来的石中剑，又插了回去。",
   "start": 0.0,
   "end": 2.728,
   "tempo": 1.074,
   "rate": 5.5
  },
  {
   "line": 2,
   "take": "x02b",
   "text": "等等，拔出来不就是国王吗？",
   "start": 2.767,
   "end": 4.77,
   "tempo": 1.099,
   "rate": 5.49
  },
  {
   "line": 3,
   "take": "x03b",
   "text": "名著《亚瑟王之死》里，伦敦教堂院子里多了块大石头，插着把剑。",
   "start": 4.867,
   "end": 9.424,
   "tempo": 1.173,
   "rate": 5.49
  },
  {
   "line": 4,
   "take": "x04b",
   "text": "金字写着：谁拔出来，谁就是国王。",
   "start": 9.453,
   "end": 11.874,
   "tempo": 1.297,
   "rate": 5.37
  },
  {
   "line": 5,
   "take": "x05",
   "text": "贵族排队来拔，脸都憋红了，剑一动不动。",
   "start": 11.909,
   "end": 14.984,
   "tempo": 1.301,
   "rate": 5.2
  },
  {
   "line": 6,
   "take": "x06",
   "text": "新年比武大会，亚瑟的哥哥叫凯，刚当上骑士，一摸腰，剑忘带了。",
   "start": 15.12,
   "end": 19.679,
   "tempo": 1.261,
   "rate": 5.48
  },
  {
   "line": 7,
   "take": "x07b",
   "text": "亚瑟回去拿，家里没人，全看比武去了。",
   "start": 19.705,
   "end": 22.447,
   "tempo": 1.194,
   "rate": 5.47
  },
  {
   "line": 8,
   "take": "x08",
   "text": "他想起石头上还插着一把。",
   "start": 22.473,
   "end": 24.492,
   "tempo": 1.149,
   "rate": 5.45
  },
  {
   "line": 9,
   "take": "x09b",
   "text": "连十个守卫都看比武去了，他一拔就出来，第一次。",
   "start": 24.513,
   "end": 28.076,
   "tempo": 1.041,
   "rate": 5.61
  },
  {
   "line": 10,
   "take": "x10",
   "text": "凯拿到剑就找爸爸：“爸，石中剑！我要当国王了！”",
   "start": 28.163,
   "end": 31.447,
   "tempo": 1.159,
   "rate": 5.48
  },
  {
   "line": 11,
   "take": "x11",
   "text": "爸爸让他发誓，凯才承认是弟弟拿的。",
   "start": 31.476,
   "end": 34.212,
   "tempo": 1.099,
   "rate": 5.48
  },
  {
   "line": 12,
   "take": "x12",
   "text": "爸爸让亚瑟插回去再拔一次，他说：“这有什么难的。”",
   "start": 34.243,
   "end": 37.889,
   "tempo": 1.136,
   "rate": 5.49
  },
  {
   "line": 13,
   "take": "x13",
   "text": "爸爸先拔，不动；凯使出吃奶的劲，不动；亚瑟一伸手，第二次。",
   "start": 37.92,
   "end": 42.109,
   "tempo": 1.227,
   "rate": 5.49
  },
  {
   "line": 14,
   "take": "x14",
   "text": "几天后贵族全来试，只有他拔得出，第三次。",
   "start": 42.242,
   "end": 45.347,
   "tempo": 1.344,
   "rate": 5.48
  },
  {
   "line": 15,
   "take": "x15b",
   "text": "他们气炸了：“让个出身不高的小子管我们？”说改天再拔。",
   "start": 45.375,
   "end": 49.387,
   "tempo": 1.093,
   "rate": 5.48
  },
  {
   "line": 16,
   "take": "x16b",
   "text": "二月，雪还没化，第四次，又拖。",
   "start": 49.475,
   "end": 52.158,
   "tempo": 1.242,
   "rate": 4.1
  },
  {
   "line": 17,
   "take": "x17",
   "text": "春天，花都开了，第五次，还拖。",
   "start": 52.185,
   "end": 54.945,
   "tempo": 1.207,
   "rate": 3.99
  },
  {
   "line": 18,
   "take": "x18",
   "text": "初夏，当着所有人的面，第六次。",
   "start": 54.968,
   "end": 57.157,
   "tempo": 1.301,
   "rate": 5.48
  },
  {
   "line": 19,
   "take": "x19",
   "text": "老百姓急了：“就要亚瑟当国王，别再拖了！”",
   "start": 57.249,
   "end": 60.177,
   "tempo": 1.145,
   "rate": 5.46
  },
  {
   "line": 20,
   "take": "x20b",
   "text": "所有人齐刷刷跪下。",
   "start": 60.199,
   "end": 61.658,
   "tempo": 1.339,
   "rate": 5.48
  },
  {
   "line": 21,
   "take": "x21",
   "text": "整整六次，他才当上国王，而第一次，只因为哥哥忘了带剑。",
   "start": 61.773,
   "end": 65.963,
   "tempo": 1.2,
   "rate": 5.49
  }
 ]
}