[[0.6, 2.9857142857142858, "路边一只猫被车撞了"], [3.105714285714286, 5.491428571428571, "很多人会难过一整天"], [5.611428571428571, 7.854285714285714, "2018年，肯尼亚"], [7.974285714285714, 11.36, "世界上最后一只雄性北方白犀牛死了"], [11.479999999999999, 13.579999999999998, "它叫苏丹，45岁"], [13.699999999999998, 15.94285714285714, "全世界都为它难过"], [17.0, 19.385714285714286, "一只苍蝇落在窗台上"], [19.6, 22.12857142857143, "一巴掌，没人会多看一眼"], [22.4, 24.299999999999997, "苍蝇、猫、犀牛"], [24.419999999999998, 26.319999999999997, "都是一条命"], [27.0, 29.814285714285713, "为什么心疼的程度，差这么多"], [36.9, 39.57142857142857, "法国研究者问了三千多人"], [39.69142857142857, 42.64857142857142, "52种生物，只能救一个，你救谁"], [43.1, 45.34285714285714, "答案排成了一条线"], [45.46285714285714, 47.848571428571425, "和人类越近，越被同情"], [47.96857142857142, 50.35428571428571, "我们心里有一把尺子"], [50.474285714285706, 52.717142857142846, "刻度是：[像不像我们]"], [52.837142857142844, 56.079999999999984, "两千多年前，庄子和惠子在桥上看鱼"], [56.19999999999998, 58.29999999999998, "庄子说：鱼真快乐"], [58.41999999999998, 61.51999999999998, "惠子问：{你不是鱼}，怎么知道鱼快乐"], [63.9, 66.28571428571428, "1974年，内格尔问"], [66.40571428571428, 68.9342857142857, "做一只蝙蝠，是什么感觉"], [69.05428571428571, 72.1542857142857, "我们永远进不到另一个生命里面"], [72.27428571428571, 75.23142857142857, "只能用\"像不像我\"，去猜它疼不疼"], [75.35142857142857, 78.02285714285715, "所以猫让人心疼，苍蝇不会"], [78.6, 81.12857142857142, "那么，这条线该画在哪里"], [84.6, 86.69999999999999, "康德说：画在[理性]"], [86.82, 89.77714285714285, "只有会思考的人，才是目的本身"], [89.89714285714285, 92.71142857142857, "对动物，我们没有直接的义务"], [92.83142857142857, 95.36, "可他也说：虐待动物的人"], [95.48, 97.72285714285715, "对人，也会变得冷酷"], [97.84285714285716, 99.94285714285715, "边沁说：画在[痛苦]"], [100.06285714285715, 103.44857142857144, "问题不是它们能不能思考，能不能说话"], [103.56857142857145, 105.95428571428573, "而是：它们会不会痛苦"], [106.07428571428574, 109.17428571428573, "1975年，辛格在《动物解放》里说"], [109.29428571428573, 112.25142857142859, "同样的痛苦，就该被同样地在乎"], [112.3714285714286, 115.47142857142859, "一只鸡的痛，和一只狗的痛，一样重"], [115.5914285714286, 118.12000000000002, "只因为不是人，就不算数"], [118.24000000000002, 120.34000000000002, "这叫作{物种歧视}"], [120.46000000000002, 123.27428571428574, "就像种族歧视、性别歧视一样"], [123.39428571428574, 125.92285714285717, "史怀哲说：画在[生命本身]"], [126.3, 129.68571428571428, "一百多年前，非洲河上，船穿过一群河马"], [129.8057142857143, 132.33428571428573, "他想到四个字：敬畏生命"], [132.45428571428573, 134.84, "我是想活下去的生命"], [134.96, 137.91714285714286, "活在同样想活下去的生命之中"], [138.03714285714287, 140.42285714285714, "他拒绝给生命排高低"], [140.54285714285714, 142.64285714285714, "活着，免不了伤害"], [142.76285714285714, 144.86285714285714, "但不该{毫无必要}"], [147.1, 149.48571428571427, "1869年，莱基写道"], [149.60571428571427, 152.1342857142857, "人的善意，最先只给家人"], [152.25428571428571, 154.78285714285715, "后来是阶层、国家、全人类"], [154.90285714285716, 157.00285714285715, "最后，才轮到动物"], [157.12285714285716, 159.22285714285715, "所以，生命平等吗"], [159.34285714285716, 162.15714285714287, "在我们的感觉里，从来不平等"], [162.27714285714288, 164.66285714285715, "但这个圈，一直在变大"], [167.9, 170.14285714285714, "苏丹让全世界难过"], [170.26285714285714, 172.93428571428572, "不是因为它比苍蝇更值钱"], [173.05428571428573, 175.44, "是因为我们[看见了它]"], [175.56, 177.46, "庄子说"], [177.58, 180.53714285714287, "天地与我并生，而[万物与我为一]"]]