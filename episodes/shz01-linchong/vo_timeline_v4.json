{
 "tempo": 1.08,
 "voice": "WuLq5z7nEcrhppO0ZQJw (same narrator as v2), eleven_v4, run shz01-vo-03",
 "lines": [
  {
   "id": "W01",
   "start": 0.3,
   "dur": 5.515,
   "end": 5.815,
   "text": "东京八十万禁军教头林冲，为因身犯重罪，断配沧州，"
  },
  {
   "id": "W02",
   "start": 6.4,
   "dur": 3.217,
   "end": 9.617,
   "text": "情愿立此休书，任从改嫁。"
  },
  {
   "id": "W03",
   "start": 10.15,
   "dur": 2.564,
   "end": 12.714,
   "text": "这是林冲留给妻子的休书。"
  },
  {
   "id": "W04",
   "start": 13.25,
   "dur": 2.999,
   "end": 16.249,
   "text": "成亲三年，两人没红过一次脸。"
  },
  {
   "id": "W05",
   "start": 16.75,
   "dur": 1.524,
   "end": 18.274,
   "text": "他为什么要休了她？"
  },
  {
   "id": "W06",
   "start": 27.05,
   "dur": 3.289,
   "end": 30.339,
   "text": "那时候，他有一身本事，有一个家。"
  },
  {
   "id": "W07",
   "start": 31.45,
   "dur": 3.507,
   "end": 34.957,
   "text": "直到那天在岳庙，有人调戏他的娘子。"
  },
  {
   "id": "W08",
   "start": 35.65,
   "dur": 2.709,
   "end": 38.359,
   "text": "他一把扳过那人，拳头举起来——"
  },
  {
   "id": "W09",
   "start": 39.45,
   "dur": 3.144,
   "end": 42.594,
   "text": "却认出，那是上司高太尉的干儿子。"
  },
  {
   "id": "W10",
   "start": 43.4,
   "dur": 2.177,
   "end": 45.577,
   "text": "拳头，软了。"
  },
  {
   "id": "W11",
   "start": 45.85,
   "dur": 3.217,
   "end": 49.067,
   "text": "连最好的朋友陆谦，也站到了他们那边。"
  },
  {
   "id": "W12",
   "start": 49.3,
   "dur": 3.362,
   "end": 52.662,
   "text": "一把宝刀，把他引进了白虎节堂。"
  },
  {
   "id": "W13",
   "start": 52.9,
   "dur": 2.322,
   "end": 55.222,
   "text": "刺了面，押往沧州。"
  },
  {
   "id": "W14",
   "start": 55.45,
   "dur": 2.854,
   "end": 58.304,
   "text": "临走前，他请人写了这封休书。"
  },
  {
   "id": "W15",
   "start": 58.55,
   "dur": 1.814,
   "end": 60.364,
   "text": "他怕自己死在路上，"
  },
  {
   "id": "W16",
   "start": 60.6,
   "dur": 2.999,
   "end": 63.599,
   "text": "更怕高衙内逼她，误了她一辈子。"
  },
  {
   "id": "W17",
   "start": 63.85,
   "dur": 4.257,
   "end": 68.107,
   "text": "她哭着问：我清清白白，你为什么不要我？"
  },
  {
   "id": "W18",
   "start": 68.35,
   "dur": 2.177,
   "end": 70.527,
   "text": "他只说：我是好意。"
  },
  {
   "id": "W19",
   "start": 70.75,
   "dur": 4.33,
   "end": 75.08,
   "text": "岳父说：放你回来时，依旧夫妻完聚。"
  },
  {
   "id": "W20",
   "start": 75.35,
   "dur": 2.927,
   "end": 78.277,
   "text": "为了这句话，他忍着活下去。"
  },
  {
   "id": "W21",
   "start": 78.55,
   "dur": 3.362,
   "end": 81.912,
   "text": "沧州下了大雪，压塌了他的草屋。"
  },
  {
   "id": "W22",
   "start": 82.15,
   "dur": 3.435,
   "end": 85.585,
   "text": "他躲进山神庙，草料场却烧了起来。"
  },
  {
   "id": "W23",
   "start": 85.85,
   "dur": 1.959,
   "end": 87.809,
   "text": "门外是陆谦的声音："
  },
  {
   "id": "W24",
   "start": 88.1,
   "dur": 3.362,
   "end": 91.462,
   "text": "烧死了，拾他一两块骨头回去交差。"
  },
  {
   "id": "W25",
   "start": 91.8,
   "dur": 1.209,
   "end": 93.009,
   "text": "回不去了。"
  },
  {
   "id": "W26",
   "start": 93.65,
   "dur": 1.669,
   "end": 95.319,
   "text": "他一把拽开庙门。"
  },
  {
   "id": "W27",
   "start": 95.6,
   "dur": 4.039,
   "end": 99.639,
   "text": "一枪戳倒差拨，再一枪，追倒了逃跑的富安。"
  },
  {
   "id": "W28",
   "start": 100.3,
   "dur": 4.184,
   "end": 104.484,
   "text": "陆谦被他掀翻在雪里，刀，就搁在脸上。"
  },
  {
   "id": "W29",
   "start": 104.684,
   "dur": 2.782,
   "end": 107.466,
   "text": "杀人可恕，情理难容！"
  },
  {
   "id": "W30",
   "start": 107.666,
   "dur": 2.104,
   "end": 109.77,
   "text": "这一回，他没有再忍。"
  },
  {
   "id": "W31",
   "start": 110.15,
   "dur": 2.322,
   "end": 112.472,
   "text": "再后来，他落草梁山。"
  },
  {
   "id": "W32",
   "start": 112.75,
   "dur": 3.362,
   "end": 116.112,
   "text": "他想接娘子上山，却一拖再拖。"
  },
  {
   "id": "W33",
   "start": 116.312,
   "dur": 5.007,
   "end": 121.319,
   "text": "派去的人回来说：娘子被逼自尽，已故半载。"
  },
  {
   "id": "W34",
   "start": 121.6,
   "dur": 1.137,
   "end": 122.737,
   "text": "他哭了。"
  },
  {
   "id": "W35",
   "start": 123.1,
   "dur": 2.636,
   "end": 125.736,
   "text": "那封休书，没能护住她。"
  },
  {
   "id": "W36",
   "start": 126.25,
   "dur": 3.217,
   "end": 129.467,
   "text": "他立下它，只是想让她好好活着。"
  },
  {
   "id": "W37",
   "start": 129.95,
   "dur": 3.217,
   "end": 133.167,
   "text": "从此，他心里再没有可挂念的人。"
  },
  {
   "id": "W38",
   "start": 134.15,
   "dur": 1.959,
   "end": 136.109,
   "text": "依旧夫妻完聚——"
  },
  {
   "id": "W39",
   "start": 137.55,
   "dur": 2.709,
   "end": 140.259,
   "text": "这句话，他终究没能等到。"
  }
 ]
}