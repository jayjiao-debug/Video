[
 {
  "start": 0.0,
  "end": 2.89,
  "text": "军训报数，一百多人又报乱了"
 },
 {
  "start": 2.99,
  "end": 5.45,
  "text": "第三遍了，还得从头报"
 },
 {
  "start": 5.55,
  "end": 8.01,
  "text": "其实，排[三次]队就够了"
 },
 {
  "start": 8.11,
  "end": 11.0,
  "text": "看每次多出几个，就知道[128]人"
 },
 {
  "start": 11.1,
  "end": 13.56,
  "text": "传说，[韩信]就这样点兵"
 },
 {
  "start": 13.66,
  "end": 16.4,
  "text": "今天，它还藏在加密[钥匙]里"
 },
 {
  "start": 20.7,
  "end": 22.98,
  "text": "从100到199，100种可能"
 },
 {
  "start": 23.08,
  "end": 25.64,
  "text": "三人一排多2个：剩[33]种"
 },
 {
  "start": 25.74,
  "end": 28.3,
  "text": "五人一排多3个：剩[6]种"
 },
 {
  "start": 28.4,
  "end": 30.96,
  "text": "七人一排多2个：只剩[128]"
 },
 {
  "start": 31.06,
  "end": 33.77,
  "text": "可最早的记载里，没有[韩信]"
 },
 {
  "start": 33.87,
  "end": 36.43,
  "text": "[韩信点兵]，是后来的传说"
 },
 {
  "start": 36.53,
  "end": 38.82,
  "text": "《孙子算经》，1600多年前"
 },
 {
  "start": 38.92,
  "end": 41.63,
  "text": "原文只说：今有物不知其数"
 },
 {
  "start": 41.73,
  "end": 44.58,
  "text": "同样的余数，原书答案却是[23]"
 },
 {
  "start": 44.68,
  "end": 47.24,
  "text": "原书先找三个数：70、21、15"
 },
 {
  "start": 47.34,
  "end": 51.34,
  "text": "70人三人一排多1，五人七人排满"
 },
 {
  "start": 51.44,
  "end": 54.15,
  "text": "多几个就拿几份，加起来[233]"
 },
 {
  "start": 54.25,
  "end": 56.67,
  "text": "105人：三种排法都排满"
 },
 {
  "start": 56.77,
  "end": 59.05,
  "text": "233减两个105：正是[23]"
 },
 {
  "start": 59.15,
  "end": 63.15,
  "text": "所以23、128、233，[都对]"
 },
 {
  "start": 63.25,
  "end": 66.02,
  "text": "1247年，秦九韶写出通用解法"
 },
 {
  "start": 66.12,
  "end": 68.9,
  "text": "[求一]：找个乘数，让余数剩1"
 },
 {
  "start": 69.0,
  "end": 71.77,
  "text": "35乘几，除以3剩1？乘2：[70]"
 },
 {
  "start": 71.87,
  "end": 74.64,
  "text": "到今天，[RSA]加密也在算余数"
 },
 {
  "start": 74.74,
  "end": 77.66,
  "text": "解密钥匙里，还多存了三个数"
 },
 {
  "start": 77.76,
  "end": 79.38,
  "text": "[dP]、[dQ]、[qInv]"
 },
 {
  "start": 81.45,
  "end": 86.77,
  "text": "CRT：[中国剩余定理]"
 },
 {
  "start": 86.87,
  "end": 89.9,
  "text": "解密：拆成p、q两个小计算，更快"
 },
 {
  "start": 90.0,
  "end": 92.76,
  "text": "再用[qInv]，把两个结果拼回来"
 },
 {
  "start": 92.86,
  "end": 95.47,
  "text": "q乘qInv，除以p正好剩[1]"
 },
 {
  "start": 95.57,
  "end": 98.04,
  "text": "这正是秦九韶的[求一]"
 },
 {
  "start": 98.14,
  "end": 101.03,
  "text": "不过，除数之间不能有公因数"
 },
 {
  "start": 101.13,
  "end": 104.03,
  "text": "比如除4剩1、除6剩2：[无解]"
 },
 {
  "start": 104.13,
  "end": 106.74,
  "text": "一个要单数，一个要双数"
 },
 {
  "start": 106.84,
  "end": 109.59,
  "text": "而且，得先知道[大概]有多少"
 },
 {
  "start": 109.7,
  "end": 112.3,
  "text": "所以一百多人，只能是[128]"
 },
 {
  "start": 112.4,
  "end": 115.3,
  "text": "下次报数乱了，试试排三次队"
 }
]