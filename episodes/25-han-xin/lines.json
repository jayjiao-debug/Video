[
 {
  "start": 0.0,
  "end": 2.89,
  "text": "军训报数，一百多人又报乱了"
 },
 {
  "start": 2.99,
  "end": 5.45,
  "text": "第三遍了，还得从头报"
 },
 {
  "start": 5.55,
  "end": 8.01,
  "text": "其实，排[三次]队就够了"
 },
 {
  "start": 8.11,
  "end": 11.0,
  "text": "看每次多出几个，就知道[128]人"
 },
 {
  "start": 11.1,
  "end": 13.56,
  "text": "传说，[韩信]就这样点兵"
 },
 {
  "start": 13.66,
  "end": 16.4,
  "text": "今天，它还藏在加密[钥匙]里"
 },
 {
  "start": 20.8,
  "end": 23.2,
  "text": "一百多人，有100种可能"
 },
 {
  "start": 23.3,
  "end": 26.27,
  "text": "三人排多2、五人排多3：剩[6]种"
 },
 {
  "start": 26.37,
  "end": 28.63,
  "text": "七人排多2：只剩[128]"
 },
 {
  "start": 28.73,
  "end": 31.41,
  "text": "可最早的记载里，没有[韩信]"
 },
 {
  "start": 31.51,
  "end": 33.91,
  "text": "《孙子算经》，约1600多年前"
 },
 {
  "start": 34.01,
  "end": 36.69,
  "text": "原文只说：今有物不知其数"
 },
 {
  "start": 36.79,
  "end": 39.76,
  "text": "三个余数，和我们连队一模一样"
 },
 {
  "start": 39.86,
  "end": 42.54,
  "text": "南宋杨辉，叫它[秦王暗点兵]"
 },
 {
  "start": 42.64,
  "end": 45.18,
  "text": "[韩信点兵]，是后来的传说"
 },
 {
  "start": 45.28,
  "end": 47.39,
  "text": "原书答案却是：[23]"
 },
 {
  "start": 47.49,
  "end": 50.03,
  "text": "孙子先找三个数：70、21、15"
 },
 {
  "start": 50.13,
  "end": 53.1,
  "text": "每个只在一种排法里，多出1个"
 },
 {
  "start": 53.2,
  "end": 55.88,
  "text": "多几个就拿几份，加起来[233]"
 },
 {
  "start": 55.98,
  "end": 58.09,
  "text": "再减去[210]，得到23"
 },
 {
  "start": 58.19,
  "end": 60.87,
  "text": "105人，三种排法都正好排满"
 },
 {
  "start": 60.97,
  "end": 63.1,
  "text": "所以23、128、233，[都对]"
 },
 {
  "start": 63.25,
  "end": 66.06,
  "text": "1247年，秦九韶写出通用解法"
 },
 {
  "start": 66.16,
  "end": 68.54,
  "text": "核心叫[大衍求一术]"
 },
 {
  "start": 68.64,
  "end": 71.45,
  "text": "到今天，[RSA]解密也在算余数"
 },
 {
  "start": 71.55,
  "end": 74.5,
  "text": "除数n，是p和q两个数相乘"
 },
 {
  "start": 74.6,
  "end": 77.55,
  "text": "它的私钥里，专门存了三个数"
 },
 {
  "start": 77.65,
  "end": 79.3,
  "text": "[dP]、[dQ]、[qInv]"
 },
 {
  "start": 81.45,
  "end": 83.64,
  "text": "CRT：[中国剩余定理]"
 },
 {
  "start": 83.74,
  "end": 86.64,
  "text": "西方，就这样称呼孙子的方法"
 },
 {
  "start": 86.74,
  "end": 89.64,
  "text": "解密：先算除以p、q的小余数"
 },
 {
  "start": 89.74,
  "end": 92.22,
  "text": "再用[qInv]，拼回解密结果"
 },
 {
  "start": 92.32,
  "end": 94.94,
  "text": "q乘qInv，除以p正好剩[1]"
 },
 {
  "start": 95.04,
  "end": 97.52,
  "text": "这正是秦九韶的[求一]"
 },
 {
  "start": 97.62,
  "end": 100.1,
  "text": "不过，这招有两个[前提]"
 },
 {
  "start": 100.2,
  "end": 102.96,
  "text": "一：除数之间，不能有公因数"
 },
 {
  "start": 103.06,
  "end": 105.96,
  "text": "比如除4剩1、除6剩2：无解"
 },
 {
  "start": 106.06,
  "end": 108.68,
  "text": "二：得先知道[大概]有多少"
 },
 {
  "start": 108.78,
  "end": 111.4,
  "text": "所以一百多人，只能是[128]"
 },
 {
  "start": 111.5,
  "end": 114.4,
  "text": "下次报数乱了，试试排三次队"
 }
]