[
 {
  "id": "Q0",
  "voice": "心声",
  "start": 0.0,
  "end": 2.26,
  "text": "“人活着，到底为了什么？”"
 },
 {
  "id": "HK1",
  "voice": "ZH",
  "start": 2.267,
  "end": 6.109,
  "text": "哈佛追踪[724]个人八十多年，找到了答案。"
 },
 {
  "id": "HK2",
  "voice": "ZH",
  "start": 6.229,
  "end": 10.544,
  "text": "可这个答案，[近四千年前]，就刻在一块[泥板]上。"
 },
 {
  "id": "E1",
  "voice": "ZH",
  "start": 11.891,
  "end": 15.62,
  "text": "一卷埃及[莎草纸]上，无名诗人写下："
 },
 {
  "id": "E2",
  "voice": "ZH",
  "start": 15.854,
  "end": 19.45,
  "text": "一个人，和自己的灵魂吵了起来。"
 },
 {
  "id": "E3",
  "voice": "ZH",
  "start": 19.816,
  "end": 24.2,
  "text": "人人自私贪心，这样活着，[值不值]？"
 },
 {
  "id": "B1",
  "voice": "ZH",
  "start": 25.475,
  "end": 29.827,
  "text": "[泥板]上，吉尔伽美什失去好友，想要不死。"
 },
 {
  "id": "BQ",
  "voice": "Q-女主人",
  "start": 30.003,
  "end": 32.854,
  "text": "酒馆女主人：「你找的那种生命，[你找不到]。」"
 },
 {
  "id": "B3",
  "voice": "ZH",
  "start": 33.965,
  "end": 36.297,
  "text": "她后面的话，[留到最后]。"
 },
 {
  "id": "C1",
  "voice": "ZH",
  "start": 39.06,
  "end": 42.663,
  "text": "学生问孔子：死，是怎么回事？"
 },
 {
  "id": "CQ",
  "voice": "Q-孔子",
  "start": 43.588,
  "end": 46.018,
  "text": "「活都没活明白，怎么懂得死？」"
 },
 {
  "id": "C2",
  "voice": "ZH",
  "start": 48.117,
  "end": 51.492,
  "text": "他把目光，从死[拉回了生]。"
 },
 {
  "id": "S1",
  "voice": "GR",
  "start": 52.645,
  "end": 57.68,
  "text": "苏格拉底以[30票]之差被定罪，面临死刑。"
 },
 {
  "id": "SQ",
  "voice": "GR+Q-苏",
  "start": 57.8,
  "end": 62.98,
  "text": "判刑前他说：「未经审视的人生，不值得过。」"
 },
 {
  "id": "S2",
  "voice": "ZH",
  "start": 63.1,
  "end": 66.676,
  "text": "照他说，你凌晨三点那一问，[问得好]。"
 },
 {
  "id": "M1",
  "voice": "GR",
  "start": 66.796,
  "end": 70.073,
  "text": "罗马皇帝马可·奥勒留，写给自己："
 },
 {
  "id": "MQ1",
  "voice": "Q-马可",
  "start": 70.193,
  "end": 74.03,
  "text": "「早上不想起床时，就告诉自己：」"
 },
 {
  "id": "MQ2",
  "voice": "Q-马可",
  "start": 74.15,
  "end": 76.8,
  "text": "「我起来，是去[做一个人该做的事]。」"
 },
 {
  "id": "M2",
  "voice": "ZH",
  "start": 76.985,
  "end": 79.645,
  "text": "管着帝国的人，[也不想起床]。"
 },
 {
  "id": "F0",
  "voice": "DE",
  "start": 80.381,
  "end": 84.79,
  "text": "医生弗兰克尔一家，被押进了集中营。"
 },
 {
  "id": "F1",
  "voice": "DE",
  "start": 84.91,
  "end": 88.997,
  "text": "黎明行军时，他一直想着妻子的脸。"
 },
 {
  "id": "F2",
  "voice": "DE",
  "start": 90.004,
  "end": 95.0,
  "text": "他明白了：爱，是人能追求的[最高目标]。"
 },
 {
  "id": "F3",
  "voice": "DE",
  "start": 96.231,
  "end": 100.379,
  "text": "获救后他才知道，妻子已经不在了。"
 },
 {
  "id": "F4",
  "voice": "ZH",
  "start": 101.891,
  "end": 106.05,
  "text": "一无所有的人，想着所爱，也能感到[幸福]。"
 },
 {
  "id": "H1",
  "voice": "EN",
  "start": 108.118,
  "end": 112.526,
  "text": "1938年起，哈佛追踪了[724]个人的一生。"
 },
 {
  "id": "H3",
  "voice": "EN",
  "start": 112.646,
  "end": 116.815,
  "text": "结果：好的[人际关系]，让人更快乐、更健康。"
 },
 {
  "id": "R1",
  "voice": "ZH",
  "start": 117.157,
  "end": 120.106,
  "text": "泥板上，酒馆女主人接着说："
 },
 {
  "id": "RQ1",
  "voice": "Q-女主人",
  "start": 120.257,
  "end": 122.719,
  "text": "「看看那个[牵着你手的孩子]，」"
 },
 {
  "id": "RQ2",
  "voice": "Q-女主人",
  "start": 123.607,
  "end": 125.681,
  "text": "「常常拥抱你的妻子。」"
 },
 {
  "id": "L1",
  "voice": "ZH",
  "start": 127.03,
  "end": 130.078,
  "text": "泥板上的答案，真的和[哈佛]一样。"
 },
 {
  "id": "TE",
  "voice": "ZH",
  "start": 132.104,
  "end": 135.551,
  "text": "你把“为了什么”，改成了“为了[谁]”。"
 },
 {
  "id": "T2",
  "voice": "朋友",
  "start": 137.765,
  "end": 140.074,
  "text": "朋友的语音：你也没睡？明天吃火锅！"
 },
 {
  "id": "T3",
  "voice": "ZH",
  "start": 141.727,
  "end": 143.891,
  "text": "你活着，是为了[谁]？"
 }
]