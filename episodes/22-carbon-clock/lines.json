[
 {
  "start": 0.0,
  "end": 2.55,
  "text": "展柜里写着：距今几千年"
 },
 {
  "start": 2.65,
  "end": 5.06,
  "text": "可木炭身上，没写日期"
 },
 {
  "start": 5.16,
  "end": 8.29,
  "text": "活着时，每克碳每分钟滴答约[15]下"
 },
 {
  "start": 8.39,
  "end": 10.66,
  "text": "死后，滴答越来越[慢]"
 },
 {
  "start": 10.76,
  "end": 13.6,
  "text": "剩几下，就能说出它死了多久"
 },
 {
  "start": 13.7,
  "end": 16.4,
  "text": "你身上也有这只钟，正在走"
 },
 {
  "start": 20.8,
  "end": 23.58,
  "text": "空气里，有极少量的[碳14]"
 },
 {
  "start": 23.68,
  "end": 26.18,
  "text": "树吸进它，人吃进它"
 },
 {
  "start": 26.28,
  "end": 29.35,
  "text": "活着时，体内含量和空气[同步]"
 },
 {
  "start": 29.45,
  "end": 32.09,
  "text": "死后不再补，只剩[衰变]"
 },
 {
  "start": 32.19,
  "end": 34.97,
  "text": "每过约[5730]年，滴答少一半"
 },
 {
  "start": 35.07,
  "end": 37.71,
  "text": "剩1/4，就是约[1.1万]年"
 },
 {
  "start": 37.81,
  "end": 40.73,
  "text": "量出剩多少，就能倒推时间"
 },
 {
  "start": 40.83,
  "end": 43.75,
  "text": "这套方法，出自化学家[利比]"
 },
 {
  "start": 43.85,
  "end": 46.06,
  "text": "它叫[碳14测年]"
 },
 {
  "start": 46.16,
  "end": 48.95,
  "text": "考古、地质，都靠它测年代"
 },
 {
  "start": 49.1,
  "end": 51.66,
  "text": "这只钟准吗？先[考一考]"
 },
 {
  "start": 51.76,
  "end": 54.75,
  "text": "1949年，利比找来法老墓的木头"
 },
 {
  "start": 54.85,
  "end": 57.55,
  "text": "年代早已知道：约[4600年]前"
 },
 {
  "start": 57.65,
  "end": 60.35,
  "text": "他写道：“吻合得令人满意”"
 },
 {
  "start": 60.45,
  "end": 63.15,
  "text": "1960年，他为此获[诺贝尔奖]"
 },
 {
  "start": 63.25,
  "end": 66.07,
  "text": "1959年，利比的书到了中国"
 },
 {
  "start": 66.17,
  "end": 69.13,
  "text": "1965年，新实验室也先考自己"
 },
 {
  "start": 69.23,
  "end": 72.47,
  "text": "[4]块已知年代的木头，全都对上"
 },
 {
  "start": 72.57,
  "end": 75.96,
  "text": "中国第一间碳14实验室，这才成立"
 },
 {
  "start": 76.06,
  "end": 79.3,
  "text": "这只钟的前提：空气里碳14[不变]"
 },
 {
  "start": 81.45,
  "end": 84.1,
  "text": "1960年代，大气碳14约[翻倍]"
 },
 {
  "start": 84.2,
  "end": 86.27,
  "text": "原因是[核试验]"
 },
 {
  "start": 86.37,
  "end": 89.44,
  "text": "那几年的活物，体内也跟着翻倍"
 },
 {
  "start": 89.54,
  "end": 92.61,
  "text": "前提错了：空气里碳14一直在变"
 },
 {
  "start": 92.71,
  "end": 95.36,
  "text": "所以，钟要拿[树轮]来校准"
 },
 {
  "start": 95.46,
  "end": 98.25,
  "text": "每圈树轮，年份精确到一年"
 },
 {
  "start": 98.35,
  "end": 101.28,
  "text": "测出每圈的碳14，排成[对照表]"
 },
 {
  "start": 101.38,
  "end": 104.17,
  "text": "木炭的读数，到表里查年份"
 },
 {
  "start": 104.27,
  "end": 107.2,
  "text": "往前，超过约[5万]年就剩太少"
 },
 {
  "start": 107.3,
  "end": 110.09,
  "text": "往后，核弹尖峰成了新的[钟]"
 },
 {
  "start": 110.19,
  "end": 112.41,
  "text": "一块木炭有多老？"
 },
 {
  "start": 112.51,
  "end": 115.3,
  "text": "数它的滴答，再拿树轮[对表]"
 }
]