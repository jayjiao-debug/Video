[
 {
  "start": 0.0,
  "end": 2.55,
  "text": "展柜里写着：距今几千年"
 },
 {
  "start": 2.65,
  "end": 5.06,
  "text": "可木炭身上，没写日期"
 },
 {
  "start": 5.16,
  "end": 8.29,
  "text": "活着时，每克碳每分钟滴答约[15]下"
 },
 {
  "start": 8.39,
  "end": 10.66,
  "text": "死后，滴答越来越[慢]"
 },
 {
  "start": 10.76,
  "end": 13.6,
  "text": "剩几下，就能说出它死了多久"
 },
 {
  "start": 13.7,
  "end": 16.4,
  "text": "你身上，也有这只钟"
 },
 {
  "start": 20.8,
  "end": 26.14,
  "text": "空气里，有极少量的[碳14]"
 },
 {
  "start": 26.24,
  "end": 31.71,
  "text": "碳14每衰变一个，就是一声[滴答]"
 },
 {
  "start": 31.81,
  "end": 37.28,
  "text": "活着时不断补回，比例和空气[一样]"
 },
 {
  "start": 37.38,
  "end": 42.85,
  "text": "死后不再补，只剩[衰变]"
 },
 {
  "start": 42.95,
  "end": 48.95,
  "text": "每过约[5730]年，滴答少一半"
 },
 {
  "start": 49.1,
  "end": 51.96,
  "text": "这只钟准吗？发明人先[考一考]"
 },
 {
  "start": 52.06,
  "end": 55.5,
  "text": "1949年，利比找来法老墓的木头"
 },
 {
  "start": 55.6,
  "end": 59.05,
  "text": "年代早已知道：距今约[4700年]"
 },
 {
  "start": 59.15,
  "end": 63.1,
  "text": "论文写道：“吻合得令人满意”"
 },
 {
  "start": 63.25,
  "end": 66.13,
  "text": "中国物理学家，拿到利比的书"
 },
 {
  "start": 66.23,
  "end": 69.17,
  "text": "1965年，实验室成立前先考一考"
 },
 {
  "start": 69.27,
  "end": 72.21,
  "text": "[4]块已知年代的木头，全都对上"
 },
 {
  "start": 72.31,
  "end": 75.75,
  "text": "中国第一间碳14实验室，这才成立"
 },
 {
  "start": 75.85,
  "end": 79.3,
  "text": "这只钟的前提：空气里碳14[不变]"
 },
 {
  "start": 81.45,
  "end": 84.36,
  "text": "1960年代，大气碳14约[翻倍]"
 },
 {
  "start": 84.46,
  "end": 86.38,
  "text": "原因是[核试验]"
 },
 {
  "start": 86.48,
  "end": 89.92,
  "text": "前提错了：空气里碳14一直在变"
 },
 {
  "start": 90.02,
  "end": 93.47,
  "text": "当年的吻合，是在误差范围内"
 },
 {
  "start": 93.57,
  "end": 97.52,
  "text": "要更准，拿[树轮]校准：每圈年份准确"
 },
 {
  "start": 97.62,
  "end": 101.06,
  "text": "测出每圈的碳14，排成[对照表]"
 },
 {
  "start": 101.16,
  "end": 104.6,
  "text": "太老的不行：超过约[5万]年就剩太少"
 },
 {
  "start": 104.7,
  "end": 108.15,
  "text": "核试验尖峰后逐年回落，成了新的[钟]"
 },
 {
  "start": 108.25,
  "end": 111.18,
  "text": "你身上的钟，跟着今天的空气"
 },
 {
  "start": 111.28,
  "end": 115.3,
  "text": "一块木炭有多老？数滴答，再[对表]"
 }
]