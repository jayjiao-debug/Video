{
 "tempo": 1.08,
 "request": "shz02-vo-01",
 "anchors": {
  "title": 18.657,
  "hit": 26.97,
  "drop": 93.565,
  "endcard": 141.862,
  "dur": 148.5
 },
 "lines": [
  {
   "id": "L01",
   "start": 0.3,
   "dur": 5.185,
   "end": 5.485,
   "text": "武松在景阳冈打死一只老虎，被人用轿子抬着，成了英雄。"
  },
  {
   "id": "L02",
   "start": 6.9,
   "dur": 3.556,
   "end": 10.456,
   "text": "李逵在沂岭，一夜之间，杀了四只。"
  },
  {
   "id": "L03",
   "start": 10.9,
   "dur": 3.407,
   "end": 14.307,
   "text": "可天亮以后，他连自己的名字都不敢说。"
  },
  {
   "id": "L04",
   "start": 14.9,
   "dur": 2.889,
   "end": 17.789,
   "text": "因为那一夜，他不是去打虎的。"
  },
  {
   "id": "L05",
   "start": 27.05,
   "dur": 4.593,
   "end": 31.643,
   "text": "这天，梁山摆酒，庆贺宋江把父亲接上了山。"
  },
  {
   "id": "L06",
   "start": 31.84,
   "dur": 3.481,
   "end": 35.321,
   "text": "酒席散了，李逵忽然放声大哭："
  },
  {
   "id": "L07",
   "start": 35.52,
   "dur": 6.074,
   "end": 41.594,
   "text": "这个也去取爷，那个也去望娘，偏铁牛是土掘坑里钻出来的！"
  },
  {
   "id": "L08",
   "start": 41.8,
   "dur": 5.481,
   "end": 47.281,
   "text": "他也有个老娘，在沂水县老家。他要接她上山，快活几天。"
  },
  {
   "id": "L09",
   "start": 47.48,
   "dur": 4.593,
   "end": 52.073,
   "text": "宋江只许他独自去，不准喝酒，也不准带那两把板斧。"
  },
  {
   "id": "L10",
   "start": 52.5,
   "dur": 3.111,
   "end": 55.611,
   "text": "半路上，一个劫道的被他一刀放倒。"
  },
  {
   "id": "L11",
   "start": 55.9,
   "dur": 3.333,
   "end": 59.233,
   "text": "那人喊：家里还有个九十岁的老娘！"
  },
  {
   "id": "L12",
   "start": 59.5,
   "dur": 4.148,
   "end": 63.648,
   "text": "杀人不眨眼的李逵，放了他，还给了十两银子。"
  },
  {
   "id": "L13",
   "start": 64.6,
   "dur": 5.037,
   "end": 69.637,
   "text": "推开家门，娘坐在床上念佛，两只眼睛都瞎了。"
  },
  {
   "id": "L14",
   "start": 69.9,
   "dur": 6.37,
   "end": 76.27,
   "text": "娘说：我如常思量你，眼泪流干，因此瞎了双目。"
  },
  {
   "id": "L15",
   "start": 76.5,
   "dur": 5.111,
   "end": 81.611,
   "text": "李逵不敢说实话。他说：铁牛做了官，来接娘。"
  },
  {
   "id": "L16",
   "start": 81.9,
   "dur": 3.259,
   "end": 85.159,
   "text": "他背起娘，趁着月色翻沂岭。"
  },
  {
   "id": "L17",
   "start": 85.4,
   "dur": 5.778,
   "end": 91.178,
   "text": "半山上，娘渴得受不住。他把娘放在青石上，去找水。"
  },
  {
   "id": "L18",
   "start": 91.4,
   "dur": 1.556,
   "end": 92.956,
   "text": "等他端着水回来——"
  },
  {
   "id": "L19",
   "start": 93.65,
   "dur": 2.889,
   "end": 96.539,
   "text": "石头上，只剩他插下的那口刀。"
  },
  {
   "id": "L20",
   "start": 97.2,
   "dur": 3.185,
   "end": 100.385,
   "text": "草地上有血，一路通到一个虎洞。"
  },
  {
   "id": "L21",
   "start": 100.7,
   "dur": 4.963,
   "end": 105.663,
   "text": "李逵红了眼，提刀闯进去。小虎、母虎，一只都没放过。"
  },
  {
   "id": "L22",
   "start": 107.0,
   "dur": 5.037,
   "end": 112.037,
   "text": "狂风里，又扑出一只吊睛白额虎。他迎上去，只一刀。"
  },
  {
   "id": "L23",
   "start": 112.6,
   "dur": 6.074,
   "end": 118.674,
   "text": "天亮了。他用自己的布衫把娘包好，埋在山上，大哭了一场。"
  },
  {
   "id": "L24",
   "start": 120.4,
   "dur": 4.889,
   "end": 125.289,
   "text": "下山时，猎户们不信：一个人，怎么杀得了四只虎？"
  },
  {
   "id": "L25",
   "start": 125.8,
   "dur": 5.259,
   "end": 131.059,
   "text": "可他不敢说自己是谁：官府正悬赏三千贯，捉拿李逵。"
  },
  {
   "id": "L26",
   "start": 131.26,
   "dur": 2.296,
   "end": 133.556,
   "text": "他只说，自己叫张大胆。"
  },
  {
   "id": "L27",
   "start": 134.15,
   "dur": 2.519,
   "end": 136.669,
   "text": "武松打一只虎，做了都头。"
  },
  {
   "id": "L28",
   "start": 137.3,
   "dur": 2.593,
   "end": 139.893,
   "text": "李逵杀了四只，没了娘。"
  }
 ]
}