[
 {
  "start": 0.0,
  "end": 2.84,
  "text": "明早交论文，电脑却一直报错"
 },
 {
  "start": 2.94,
  "end": 5.78,
  "text": "后台一长串，是哪一项引起的？"
 },
 {
  "start": 5.88,
  "end": 8.72,
  "text": "微软官方：一次测[一半]最省事"
 },
 {
  "start": 8.82,
  "end": 11.52,
  "text": "通信兵修电话线，也这样找"
 },
 {
  "start": 11.62,
  "end": 14.17,
  "text": "[200]段线，逐段查最坏200次"
 },
 {
  "start": 14.27,
  "end": 16.4,
  "text": "测一半：最多[8]次"
 },
 {
  "start": 20.8,
  "end": 23.7,
  "text": "线不通了，那头接线员没回应"
 },
 {
  "start": 23.8,
  "end": 26.7,
  "text": "美军通信兵手册：先走到[一半]"
 },
 {
  "start": 26.8,
  "end": 29.84,
  "text": "剪开线，接上电话，两头各试一次"
 },
 {
  "start": 29.94,
  "end": 32.98,
  "text": "摇手柄：哪边有人接，哪边是好的"
 },
 {
  "start": 33.08,
  "end": 35.84,
  "text": "坏的那半，再走到它的一半"
 },
 {
  "start": 35.94,
  "end": 38.41,
  "text": "重复，直到锁定那一段"
 },
 {
  "start": 38.51,
  "end": 41.41,
  "text": "修好后，每个剪口都要再接上"
 },
 {
  "start": 41.51,
  "end": 44.12,
  "text": "每测一次，剩下的少[一半]"
 },
 {
  "start": 44.22,
  "end": 46.83,
  "text": "200段，第[8]次就只剩1段"
 },
 {
  "start": 46.93,
  "end": 49.4,
  "text": "2的8次方＝[256]，大于200"
 },
 {
  "start": 49.5,
  "end": 51.69,
  "text": "这招叫[二分查找]"
 },
 {
  "start": 51.79,
  "end": 54.4,
  "text": "线再长一倍，只多查[1]次"
 },
 {
  "start": 54.5,
  "end": 57.11,
  "text": "[100万]个位置，也只要[20]次"
 },
 {
  "start": 57.21,
  "end": 60.11,
  "text": "电脑也一样：先只勾[一半]服务"
 },
 {
  "start": 60.21,
  "end": 62.7,
  "text": "重启一次，就排除[一半]"
 },
 {
  "start": 63.25,
  "end": 66.27,
  "text": "程序员用它找：哪次改动出了错"
 },
 {
  "start": 66.37,
  "end": 68.68,
  "text": "Git里这条命令叫[bisect]"
 },
 {
  "start": 68.78,
  "end": 71.51,
  "text": "官方示例：675个版本，约10步"
 },
 {
  "start": 71.61,
  "end": 74.63,
  "text": "内核开发者：平均每天用它一次"
 },
 {
  "start": 74.73,
  "end": 77.46,
  "text": "上万个版本里，藏着一个错"
 },
 {
  "start": 77.56,
  "end": 79.3,
  "text": "要查几次？"
 },
 {
  "start": 81.45,
  "end": 83.54,
  "text": "大约[15]步"
 },
 {
  "start": 83.64,
  "end": 86.88,
  "text": "15次对半，能分清[3.2万]个版本"
 },
 {
  "start": 86.98,
  "end": 90.07,
  "text": "最快[20到30]分钟，自动跑完"
 },
 {
  "start": 90.17,
  "end": 93.27,
  "text": "他说：这是“无条件的好东西”"
 },
 {
  "start": 94.07,
  "end": 96.42,
  "text": "但这招有个[前提]"
 },
 {
  "start": 96.52,
  "end": 99.44,
  "text": "只能有[一处]坏，测试还得准"
 },
 {
  "start": 99.54,
  "end": 102.32,
  "text": "判断错一次，后面全[跑偏]"
 },
 {
  "start": 102.42,
  "end": 105.48,
  "text": "接头时通时断，二分就会失灵"
 },
 {
  "start": 105.58,
  "end": 108.79,
  "text": "回到那台电脑：测一半，再测一半"
 },
 {
  "start": 108.89,
  "end": 111.52,
  "text": "天亮前，找到了那[一项]"
 },
 {
  "start": 111.62,
  "end": 114.4,
  "text": "不必查遍，每次排除[一半]"
 }
]