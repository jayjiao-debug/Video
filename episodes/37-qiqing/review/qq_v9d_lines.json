[[0.05, 3.815, "两千年前，《礼记》写道："], [1.074, 3.815, "人心里，天生住着七个声音。"], [4.155, 5.933, "它在你收到他消息的那一秒说"], [4.369, 5.933, "“嘴角，压不住了。”"], [6.133, 9.978, "七情之一，它叫 喜"], [8.161, 9.978, "被在乎的感觉，藏不住。"], [10.238, 12.033, "它在你被冤枉时说"], [10.451, 12.033, "“凭什么是我?”"], [12.233, 16.061, "七情之二，它叫 怒"], [14.261, 16.061, "心里有火，是因为在乎公平。"], [16.321, 18.1, "它在你删掉合照时说"], [16.534, 18.1, "“原来，真的结束了。”"], [18.3, 22.144, "七情之三，它叫 哀"], [20.328, 22.144, "会疼，是因为真的爱过。"], [22.404, 24.2, "它在你按下发送前说"], [22.617, 24.2, "“万一，他不回呢?”"], [24.4, 28.226, "七情之四，它叫 惧"], [26.428, 28.226, "怕失去，所以不敢开口。"], [28.486, 30.267, "它在你记住他随口一句话时说"], [28.7, 30.267, "“他说过，他怕冷。”"], [30.467, 34.309, "七情之五，它叫 爱"], [32.494, 34.309, "心里有人，才会记得。"], [34.569, 36.367, "它在你听见虚伪的客套时说"], [34.783, 36.367, "“别装了。”"], [36.567, 40.392, "七情之六，它叫 恶"], [38.594, 40.392, "讨厌，是在替你守住底线。"], [40.652, 42.433, "它在你深夜刷购物车时说"], [40.865, 42.433, "“就这一次。”"], [42.633, 48.502, "七情之七，它叫 欲"], [44.661, 48.502, "想要，让人往前，也让人停不下。"], [48.772, 54.6, "你心里，哪个声音最大？"], [54.8, 58.96, "七情 喜怒哀惧爱恶欲"]]