[[0.116, 3.22, "特斯拉新跑车，开上了天花板"], [3.32, 5.0, "它为什么不掉下来？"], [7.732, 10.465, "车底，藏着一台大风扇"], [10.565, 13.066, "把车底的空气往外抽"], [13.166, 15.69, "外面的空气把它按在顶上"], [15.79, 18.29, "空气能推约[40吨]，车才约2吨"], [18.39, 20.914, "车底只要比外面少[约5%]"], [21.014, 24.815, "10月15日，特斯拉在 SpaceX 测试场发布"], [24.915, 28.716, "倒挂，只是第一招"], [28.816, 31.3, "第二招：飞"], [32.717, 35.659, "车里塞满了高压气瓶"], [35.759, 37.609, "一侧喷气，车就翻身"], [37.709, 38.91, "据报道：10个喷口，600升空气"], [39.01, 41.3, "落地前往下喷，刹一脚"], [41.424, 44.0, "第三招：跳"], [46.626, 49.0, "喷气，比轮胎有劲得多"], [51.618, 54.119, "0到60英里/时，不到1秒"], [54.219, 56.533, "都是特斯拉说的，还没人实测"], [56.633, 59.134, "气瓶的气用完，就飞不动了"], [59.234, 61.735, "飞多高、飞多久？没公布"], [61.835, 64.126, "会\"飞\"的版本：单座、仅邀请"], [64.226, 66.727, "而且不能开上马路"], [66.827, 69.351, "最便宜的版本，定金5万美元"], [69.451, 71.975, "量产，要等到[2028年]"], [72.075, 74.575, "倒挂，是真本事"], [74.675, 77.15, "\"飞\"，还只是一跳"], [77.253, 82.1, "托住它的，从头到尾都是[空气]"]]