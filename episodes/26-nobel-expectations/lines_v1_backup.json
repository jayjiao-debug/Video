[
 {
  "start": 0.0,
  "end": 2.46,
  "text": "老板说：明年给你涨工资"
 },
 {
  "start": 2.56,
  "end": 5.45,
  "text": "钱还没到，你今晚就多花了一点"
 },
 {
  "start": 5.55,
  "end": 7.73,
  "text": "让你花钱的，是[预期]"
 },
 {
  "start": 7.83,
  "end": 10.3,
  "text": "2012年，有人只说了一句话"
 },
 {
  "start": 10.4,
  "end": 13.14,
  "text": "西班牙借钱多付的利息，[砍半]"
 },
 {
  "start": 13.24,
  "end": 16.4,
  "text": "今年的诺贝尔经济学奖，讲的就是它"
 },
 {
  "start": 20.75,
  "end": 23.66,
  "text": "先说[霍尔]：人花钱，看的是以后"
 },
 {
  "start": 23.76,
  "end": 26.52,
  "text": "1978年：钱到账那天，并不多花"
 },
 {
  "start": 26.62,
  "end": 29.38,
  "text": "听到消息那天，你已经变了"
 },
 {
  "start": 29.48,
  "end": 32.53,
  "text": "一个国家，就是亿万个这样的你"
 },
 {
  "start": 32.63,
  "end": 35.1,
  "text": "管住[预期]，经济就更稳"
 },
 {
  "start": 35.2,
  "end": 38.25,
  "text": "再说[伍德福德]：央行该怎么说话"
 },
 {
  "start": 38.35,
  "end": 40.52,
  "text": "2012年夏天，欧元区"
 },
 {
  "start": 40.62,
  "end": 43.67,
  "text": "西班牙借10年的钱，利息冲破[7%]"
 },
 {
  "start": 43.77,
  "end": 46.39,
  "text": "越怕它还不上，利息越高"
 },
 {
  "start": 46.49,
  "end": 48.95,
  "text": "利息越高，就越还不上"
 },
 {
  "start": 49.05,
  "end": 52.33,
  "text": "7月26日，伦敦，央行行长[德拉吉]"
 },
 {
  "start": 52.43,
  "end": 55.23,
  "text": "“不惜[一切代价]，保住欧元”"
 },
 {
  "start": 55.33,
  "end": 57.66,
  "text": "“相信我，这就够了”"
 },
 {
  "start": 57.76,
  "end": 60.72,
  "text": "没说买多少，也没说怎么买"
 },
 {
  "start": 60.82,
  "end": 63.15,
  "text": "只给了一个[承诺]"
 },
 {
  "start": 63.25,
  "end": 66.67,
  "text": "9月，细则公布：买债[不设上限]"
 },
 {
  "start": 66.77,
  "end": 69.32,
  "text": "利息开始往下掉"
 },
 {
  "start": 69.42,
  "end": 72.84,
  "text": "西班牙比德国多付：[6]个多点"
 },
 {
  "start": 72.94,
  "end": 76.18,
  "text": "不到一年：降到不到[3]个点"
 },
 {
  "start": 76.28,
  "end": 79.35,
  "text": "那么，这个计划买了多少？"
 },
 {
  "start": 81.45,
  "end": 83.61,
  "text": "[一次都没买]"
 },
 {
  "start": 83.71,
  "end": 86.9,
  "text": "一分钱没花，利息照样降了"
 },
 {
  "start": 87.0,
  "end": 90.19,
  "text": "因为大家[相信]：它真的会买"
 },
 {
  "start": 90.29,
  "end": 93.82,
  "text": "伍德福德：要给[承诺]，不只是预测"
 },
 {
  "start": 93.92,
  "end": 96.42,
  "text": "但这招有个[前提]"
 },
 {
  "start": 96.52,
  "end": 99.2,
  "text": "话要被[相信]，才算数"
 },
 {
  "start": 99.3,
  "end": 102.65,
  "text": "说了做不到，下一次就没人信"
 },
 {
  "start": 102.75,
  "end": 106.11,
  "text": "预期能稳住经济，也能拖垮它"
 },
 {
  "start": 106.21,
  "end": 109.06,
  "text": "回到你：老板说的加薪"
 },
 {
  "start": 109.16,
  "end": 112.51,
  "text": "你信不信，决定你今晚怎么花"
 },
 {
  "start": 112.61,
  "end": 115.8,
  "text": "一句话的分量，在于[有人信]"
 }
]