[
 {
  "start": 0.0,
  "end": 2.43,
  "text": "老板说：明年给你涨工资"
 },
 {
  "start": 2.53,
  "end": 5.36,
  "text": "钱还没到，你今晚就多花了一点"
 },
 {
  "start": 5.46,
  "end": 8.02,
  "text": "让你花钱的，不是钱，是[预期]"
 },
 {
  "start": 8.12,
  "end": 10.68,
  "text": "说白了：老板给你[画了个饼]"
 },
 {
  "start": 10.78,
  "end": 13.34,
  "text": "饼还没到手，你就先吃上了"
 },
 {
  "start": 13.44,
  "end": 16.4,
  "text": "今年的诺贝尔经济学奖，就讲这个"
 },
 {
  "start": 20.75,
  "end": 23.32,
  "text": "以前，经济学家都以为"
 },
 {
  "start": 23.42,
  "end": 25.99,
  "text": "钱到账了，人才会多花"
 },
 {
  "start": 26.09,
  "end": 28.65,
  "text": "1978年，[霍尔]用数据一查"
 },
 {
  "start": 28.75,
  "end": 31.47,
  "text": "钱到账那天，人并不多花"
 },
 {
  "start": 31.57,
  "end": 34.43,
  "text": "多花，是在[听说]要涨的那天"
 },
 {
  "start": 34.53,
  "end": 37.54,
  "text": "你花的不是手里的钱，是[以后]"
 },
 {
  "start": 37.64,
  "end": 40.21,
  "text": "你身边的人，也都这样"
 },
 {
  "start": 40.31,
  "end": 43.17,
  "text": "全国几亿人，一起看着[以后]"
 },
 {
  "start": 43.27,
  "end": 46.13,
  "text": "所以，如果说话的不是老板"
 },
 {
  "start": 46.23,
  "end": 48.95,
  "text": "而是管着全国钱的人呢？"
 },
 {
  "start": 49.05,
  "end": 51.91,
  "text": "2012年，西班牙欠了一大笔债"
 },
 {
  "start": 52.01,
  "end": 54.72,
  "text": "旧债到期，得借新钱来还"
 },
 {
  "start": 54.82,
  "end": 57.68,
  "text": "可大家怕它还不上，不敢借"
 },
 {
  "start": 57.78,
  "end": 60.49,
  "text": "越借不到，就越[真]还不上"
 },
 {
  "start": 60.59,
  "end": 63.15,
  "text": "整个欧洲，都跟着慌了"
 },
 {
  "start": 63.25,
  "end": 65.76,
  "text": "这时，[欧洲央行]站了出来"
 },
 {
  "start": 65.86,
  "end": 68.1,
  "text": "它管着欧元，[能印钱]"
 },
 {
  "start": 68.2,
  "end": 70.57,
  "text": "行长[德拉吉]，画了个饼"
 },
 {
  "start": 70.67,
  "end": 73.72,
  "text": "西班牙缺钱？[我来借]，要多少给多少"
 },
 {
  "start": 73.82,
  "end": 76.47,
  "text": "饼还没兑现，大家就不慌了"
 },
 {
  "start": 76.57,
  "end": 79.35,
  "text": "那么，这个饼，央行掏了多少钱？"
 },
 {
  "start": 81.45,
  "end": 83.67,
  "text": "[一分钱都没有]"
 },
 {
  "start": 83.77,
  "end": 86.77,
  "text": "说好的借钱，一次都没借过"
 },
 {
  "start": 86.87,
  "end": 89.7,
  "text": "那危机，是怎么停下来的？"
 },
 {
  "start": 89.8,
  "end": 92.8,
  "text": "因为大家[信]了：它真会出手"
 },
 {
  "start": 92.9,
  "end": 95.58,
  "text": "有人兜底，就没人再怕"
 },
 {
  "start": 95.68,
  "end": 98.52,
  "text": "不怕了，漩涡就自己停了"
 },
 {
  "start": 98.62,
  "end": 102.23,
  "text": "这就是另一位得主[伍德福德]的研究"
 },
 {
  "start": 102.33,
  "end": 105.32,
  "text": "央行最有力的，往往不是钱"
 },
 {
  "start": 105.42,
  "end": 108.11,
  "text": "而是它说出口的[承诺]"
 },
 {
  "start": 108.21,
  "end": 111.2,
  "text": "但有个前提：这话得有人[信]"
 },
 {
  "start": 111.3,
  "end": 113.99,
  "text": "他说：央行要说“我保证”"
 },
 {
  "start": 114.09,
  "end": 117.08,
  "text": "不是“我觉得”：那像天气预报"
 },
 {
  "start": 117.18,
  "end": 120.48,
  "text": "“我保证”像签了字，做不到丢信用"
 },
 {
  "start": 120.58,
  "end": 123.58,
  "text": "说了做不到，下次就没人信"
 },
 {
  "start": 123.68,
  "end": 126.67,
  "text": "那个漩涡，也会转到你身边"
 },
 {
  "start": 126.77,
  "end": 129.76,
  "text": "听说要[裁员]，你今晚就少花"
 },
 {
  "start": 129.86,
  "end": 132.7,
  "text": "人人都少花，店就没生意"
 },
 {
  "start": 132.8,
  "end": 135.64,
  "text": "店没生意，就真的要裁人"
 },
 {
  "start": 135.74,
  "end": 138.73,
  "text": "回到你：老板的饼，你还信吗？"
 },
 {
  "start": 138.83,
  "end": 141.83,
  "text": "如果上次说涨薪，他没兑现"
 },
 {
  "start": 141.93,
  "end": 144.77,
  "text": "这次，你一分都不会多花"
 },
 {
  "start": 144.87,
  "end": 148.17,
  "text": "饼有没有用，看他[说话算不算数]"
 },
 {
  "start": 148.27,
  "end": 150.64,
  "text": "你说的话，也一样"
 },
 {
  "start": 150.74,
  "end": 154.2,
  "text": "你的话值多少钱？看你[兑现过几次]"
 }
]