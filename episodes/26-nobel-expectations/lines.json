[
 {
  "start": 0.0,
  "end": 2.36,
  "text": "老板说：明年给你涨工资"
 },
 {
  "start": 2.46,
  "end": 5.22,
  "text": "钱还没到，你今晚就多花了一点"
 },
 {
  "start": 5.32,
  "end": 7.82,
  "text": "让你花钱的，不是钱，是[预期]"
 },
 {
  "start": 7.92,
  "end": 10.28,
  "text": "2012年，有人只说了一句话"
 },
 {
  "start": 10.38,
  "end": 13.27,
  "text": "一分钱没花，欧洲的危机就[降温]了"
 },
 {
  "start": 13.37,
  "end": 16.4,
  "text": "今年诺贝尔经济学奖，讲的就是这个"
 },
 {
  "start": 20.75,
  "end": 23.43,
  "text": "先说[霍尔]：人花钱，看的是以后"
 },
 {
  "start": 23.53,
  "end": 26.08,
  "text": "1978年：钱到账那天，并不多花"
 },
 {
  "start": 26.18,
  "end": 28.86,
  "text": "听说要涨工资那天，你就变了"
 },
 {
  "start": 28.96,
  "end": 31.51,
  "text": "全国几亿人，都是这样的你"
 },
 {
  "start": 31.61,
  "end": 33.89,
  "text": "管住[预期]，经济就更稳"
 },
 {
  "start": 33.99,
  "end": 36.8,
  "text": "再说[伍德福德]：央行该怎么说话"
 },
 {
  "start": 36.9,
  "end": 39.18,
  "text": "2012年，西班牙急着借钱"
 },
 {
  "start": 39.28,
  "end": 41.42,
  "text": "大家越怕它还不上"
 },
 {
  "start": 41.52,
  "end": 44.2,
  "text": "借给它的利息就越高：冲破[7%]"
 },
 {
  "start": 44.3,
  "end": 46.71,
  "text": "利息越高，它就越还不上"
 },
 {
  "start": 46.81,
  "end": 48.95,
  "text": "越怕，就越[真]会出事"
 },
 {
  "start": 49.05,
  "end": 52.07,
  "text": "这时，欧洲央行的[德拉吉]上台"
 },
 {
  "start": 52.17,
  "end": 55.03,
  "text": "只说了一句：“不惜[一切代价]”"
 },
 {
  "start": 55.13,
  "end": 57.38,
  "text": "“相信我，这就够了”"
 },
 {
  "start": 57.48,
  "end": 60.34,
  "text": "意思是：没人敢借给它，我借"
 },
 {
  "start": 60.44,
  "end": 63.15,
  "text": "钱还没出，先给一个[承诺]"
 },
 {
  "start": 63.25,
  "end": 66.53,
  "text": "后来又说：借多少，[不设上限]"
 },
 {
  "start": 66.63,
  "end": 69.38,
  "text": "怕的人，一下子少了"
 },
 {
  "start": 69.48,
  "end": 72.06,
  "text": "利息开始往下掉"
 },
 {
  "start": 72.16,
  "end": 75.97,
  "text": "比德国多付的利息，不到一年[砍半]"
 },
 {
  "start": 76.07,
  "end": 79.35,
  "text": "那么，央行最后借出去多少？"
 },
 {
  "start": 81.45,
  "end": 83.62,
  "text": "[一分钱都没有]"
 },
 {
  "start": 83.72,
  "end": 86.51,
  "text": "那个计划，一次都没用过"
 },
 {
  "start": 86.61,
  "end": 89.57,
  "text": "因为大家[信]了：它真会出手"
 },
 {
  "start": 89.67,
  "end": 92.62,
  "text": "伍德福德说：央行要给[承诺]"
 },
 {
  "start": 92.72,
  "end": 95.52,
  "text": "要说“我保证”，不是“我觉得”"
 },
 {
  "start": 95.62,
  "end": 97.94,
  "text": "但这招有个[前提]"
 },
 {
  "start": 98.04,
  "end": 100.52,
  "text": "话要有人[信]，才算数"
 },
 {
  "start": 100.62,
  "end": 103.58,
  "text": "说了做不到，下次就没人信"
 },
 {
  "start": 103.68,
  "end": 106.63,
  "text": "预期能救经济，也能拖垮它"
 },
 {
  "start": 106.73,
  "end": 109.37,
  "text": "回到你：老板说的加薪"
 },
 {
  "start": 109.47,
  "end": 112.59,
  "text": "你信不信，决定你今晚怎么花"
 },
 {
  "start": 112.69,
  "end": 115.8,
  "text": "一句话值多少钱？看[多少人信]"
 }
]