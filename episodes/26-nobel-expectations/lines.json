[
 {
  "start": 0.0,
  "end": 2.42,
  "text": "老板说：明年给你涨工资"
 },
 {
  "start": 2.52,
  "end": 5.35,
  "text": "钱还没到，你今晚就多花了一点"
 },
 {
  "start": 5.45,
  "end": 8.01,
  "text": "让你花钱的，不是钱，是[预期]"
 },
 {
  "start": 8.11,
  "end": 10.67,
  "text": "说白了：老板给你[画了个饼]"
 },
 {
  "start": 10.77,
  "end": 13.33,
  "text": "饼还没到手，你就先吃上了"
 },
 {
  "start": 13.43,
  "end": 16.4,
  "text": "今年的诺贝尔经济学奖，就讲这个"
 },
 {
  "start": 20.75,
  "end": 23.45,
  "text": "以前都以为：钱到账，人才多花"
 },
 {
  "start": 23.55,
  "end": 26.24,
  "text": "[霍尔]发现：到账那天，并不多花"
 },
 {
  "start": 26.34,
  "end": 28.9,
  "text": "多花，是在[听说]要涨的那天"
 },
 {
  "start": 29.0,
  "end": 31.29,
  "text": "你花的不是钱，是[以后]"
 },
 {
  "start": 31.39,
  "end": 33.81,
  "text": "全国几亿人，都这样花钱"
 },
 {
  "start": 33.91,
  "end": 36.75,
  "text": "所以一句话，能让全国一起掏钱"
 },
 {
  "start": 36.85,
  "end": 39.41,
  "text": "反过来也一样：听说要[裁员]"
 },
 {
  "start": 39.51,
  "end": 41.79,
  "text": "你今晚，就少花了一点"
 },
 {
  "start": 41.89,
  "end": 44.31,
  "text": "你少花，楼下的店就少赚"
 },
 {
  "start": 44.41,
  "end": 46.7,
  "text": "店少赚，就真的要裁人"
 },
 {
  "start": 46.8,
  "end": 48.95,
  "text": "越怕，就越[真]会出事"
 },
 {
  "start": 49.05,
  "end": 51.91,
  "text": "2012年，整个欧洲掉进这个漩涡"
 },
 {
  "start": 52.01,
  "end": 55.3,
  "text": "大家怕西班牙还不上，都不敢借给它"
 },
 {
  "start": 55.4,
  "end": 58.54,
  "text": "这时，欧洲央行的[德拉吉]画了个饼"
 },
 {
  "start": 58.64,
  "end": 61.06,
  "text": "意思是：它缺钱，[我来借]"
 },
 {
  "start": 61.16,
  "end": 63.15,
  "text": "要多少，给多少"
 },
 {
  "start": 63.25,
  "end": 66.42,
  "text": "饼还没兑现，怕的人先少了"
 },
 {
  "start": 66.52,
  "end": 69.7,
  "text": "大家又敢借钱给西班牙了"
 },
 {
  "start": 69.8,
  "end": 73.48,
  "text": "借钱的利息，不到一年[掉了一大截]"
 },
 {
  "start": 73.58,
  "end": 75.91,
  "text": "漩涡，慢慢停了"
 },
 {
  "start": 76.01,
  "end": 79.35,
  "text": "那么，这个饼，央行掏了多少钱？"
 },
 {
  "start": 81.45,
  "end": 83.77,
  "text": "[一分钱都没有]"
 },
 {
  "start": 83.87,
  "end": 87.04,
  "text": "说好的借钱，一次都没借过"
 },
 {
  "start": 87.14,
  "end": 90.31,
  "text": "因为大家[信]了：它真会出手"
 },
 {
  "start": 90.41,
  "end": 93.75,
  "text": "[伍德福德]说：央行要说“我保证”"
 },
 {
  "start": 93.85,
  "end": 96.18,
  "text": "而不是“我觉得”"
 },
 {
  "start": 96.28,
  "end": 99.45,
  "text": "回到你：老板的饼，你还信吗？"
 },
 {
  "start": 99.55,
  "end": 102.72,
  "text": "如果上次说涨薪，他没兑现"
 },
 {
  "start": 102.82,
  "end": 105.82,
  "text": "这次，你一分都不会多花"
 },
 {
  "start": 105.92,
  "end": 109.43,
  "text": "饼有没有用，看他[说话算不算数]"
 },
 {
  "start": 109.53,
  "end": 112.02,
  "text": "你说的话，也一样"
 },
 {
  "start": 112.12,
  "end": 115.8,
  "text": "你的话值多少钱？看你[兑现过几次]"
 }
]