[
 {
  "start": 0.0,
  "end": 2.43,
  "text": "老板说：明年给你涨工资"
 },
 {
  "start": 2.53,
  "end": 5.36,
  "text": "钱还没到，你今晚就多花了一点"
 },
 {
  "start": 5.46,
  "end": 8.02,
  "text": "让你花钱的，不是钱，是[预期]"
 },
 {
  "start": 8.12,
  "end": 10.68,
  "text": "说白了：老板给你[画了个饼]"
 },
 {
  "start": 10.78,
  "end": 13.34,
  "text": "饼还没到手，你就先吃上了"
 },
 {
  "start": 13.44,
  "end": 16.4,
  "text": "今年的诺贝尔经济学奖，就讲这个"
 },
 {
  "start": 20.75,
  "end": 23.58,
  "text": "以前，经济学家都以为"
 },
 {
  "start": 23.68,
  "end": 26.51,
  "text": "钱到账了，人才会多花"
 },
 {
  "start": 26.61,
  "end": 29.43,
  "text": "1978年，[霍尔]用数据一查"
 },
 {
  "start": 29.53,
  "end": 32.52,
  "text": "钱到账那天，人并不多花"
 },
 {
  "start": 32.62,
  "end": 35.78,
  "text": "多花，是在[听说]要涨的那天"
 },
 {
  "start": 35.88,
  "end": 39.19,
  "text": "你花的不是手里的钱，是[以后]"
 },
 {
  "start": 39.29,
  "end": 42.12,
  "text": "你身边的人，也都这样"
 },
 {
  "start": 42.22,
  "end": 45.37,
  "text": "全国几亿人，一起看着[以后]"
 },
 {
  "start": 45.47,
  "end": 48.95,
  "text": "所以一句话，能让全国一起掏钱"
 },
 {
  "start": 49.05,
  "end": 51.73,
  "text": "2012年，欧洲出了大麻烦"
 },
 {
  "start": 51.83,
  "end": 54.66,
  "text": "大家怕西班牙还不上钱"
 },
 {
  "start": 54.76,
  "end": 57.29,
  "text": "越怕，越不敢借给它"
 },
 {
  "start": 57.39,
  "end": 60.37,
  "text": "越借不到钱，就越[真]还不上"
 },
 {
  "start": 60.47,
  "end": 63.15,
  "text": "整个欧洲，都跟着慌了"
 },
 {
  "start": 63.25,
  "end": 66.99,
  "text": "这时，欧洲央行的[德拉吉]画了个饼"
 },
 {
  "start": 67.09,
  "end": 70.0,
  "text": "意思是：它缺钱，[我来借]"
 },
 {
  "start": 70.1,
  "end": 72.5,
  "text": "要多少，给多少"
 },
 {
  "start": 72.6,
  "end": 75.84,
  "text": "饼还没兑现，大家就不慌了"
 },
 {
  "start": 75.94,
  "end": 79.35,
  "text": "那么，这个饼，央行掏了多少钱？"
 },
 {
  "start": 81.45,
  "end": 83.67,
  "text": "[一分钱都没有]"
 },
 {
  "start": 83.77,
  "end": 86.75,
  "text": "说好的借钱，一次都没借过"
 },
 {
  "start": 86.85,
  "end": 89.69,
  "text": "那危机，是怎么停下来的？"
 },
 {
  "start": 89.79,
  "end": 92.77,
  "text": "因为大家[信]了：它真会出手"
 },
 {
  "start": 92.87,
  "end": 95.55,
  "text": "有人兜底，就没人再怕"
 },
 {
  "start": 95.65,
  "end": 98.48,
  "text": "不怕了，漩涡就自己停了"
 },
 {
  "start": 98.58,
  "end": 102.19,
  "text": "这就是另一位得主[伍德福德]的研究"
 },
 {
  "start": 102.29,
  "end": 105.27,
  "text": "央行最有力的，往往不是钱"
 },
 {
  "start": 105.37,
  "end": 108.05,
  "text": "而是它说出口的[承诺]"
 },
 {
  "start": 108.15,
  "end": 111.14,
  "text": "但有个前提：这话得有人[信]"
 },
 {
  "start": 111.24,
  "end": 113.92,
  "text": "他说：央行要说“我保证”"
 },
 {
  "start": 114.02,
  "end": 117.01,
  "text": "不是“我觉得”：那像天气预报"
 },
 {
  "start": 117.11,
  "end": 120.55,
  "text": "“我保证”像签了字，做不到丢信用"
 },
 {
  "start": 120.65,
  "end": 123.64,
  "text": "说了做不到，下次就没人信"
 },
 {
  "start": 123.74,
  "end": 126.73,
  "text": "那个漩涡，也会转到你身边"
 },
 {
  "start": 126.83,
  "end": 129.81,
  "text": "听说要[裁员]，你今晚就少花"
 },
 {
  "start": 129.91,
  "end": 132.75,
  "text": "人人都少花，店就没生意"
 },
 {
  "start": 132.85,
  "end": 135.68,
  "text": "店没生意，就真的要裁人"
 },
 {
  "start": 135.78,
  "end": 138.77,
  "text": "回到你：老板的饼，你还信吗？"
 },
 {
  "start": 138.87,
  "end": 141.85,
  "text": "如果上次说涨薪，他没兑现"
 },
 {
  "start": 141.95,
  "end": 144.79,
  "text": "这次，你一分都不会多花"
 },
 {
  "start": 144.89,
  "end": 148.18,
  "text": "饼有没有用，看他[说话算不算数]"
 },
 {
  "start": 148.28,
  "end": 150.65,
  "text": "你说的话，也一样"
 },
 {
  "start": 150.75,
  "end": 154.2,
  "text": "你的话值多少钱？看你[兑现过几次]"
 }
]