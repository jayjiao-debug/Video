[
 {
  "start": 0,
  "end": 4.4,
  "text": "你拿到人生第一份实习工资：[4000]"
 },
 {
  "start": 4.4,
  "end": 8.5,
  "text": "开心了[整整三天]"
 },
 {
  "start": 8.5,
  "end": 12.5,
  "text": "然后室友说：他的是[6000]"
 },
 {
  "start": 12.5,
  "end": 16.4,
  "text": "你的4000，突然就[不香了]"
 },
 {
  "start": 20.6,
  "end": 24.7,
  "text": "别怪自己。连[猴子]都这样"
 },
 {
  "start": 24.7,
  "end": 28.7,
  "text": "科学家让卷尾猴，用小石子换[黄瓜]"
 },
 {
  "start": 28.7,
  "end": 32.8,
  "text": "两只都换到黄瓜：[95%]照常交换"
 },
 {
  "start": 32.8,
  "end": 36.8,
  "text": "可旁边那只，同样干活，换到[葡萄]"
 },
 {
  "start": 36.8,
  "end": 40.9,
  "text": "这只就不干了：掉到[60%]"
 },
 {
  "start": 40.9,
  "end": 44.9,
  "text": "旁边那只[啥也不干]就拿葡萄：只剩[20%]"
 },
 {
  "start": 44.9,
  "end": 48.9,
  "text": "不是黄瓜变难吃了，是[旁边有葡萄]"
 },
 {
  "start": 48.98,
  "end": 53,
  "text": "人呢？哈佛问过257个人一道题"
 },
 {
  "start": 53,
  "end": 57,
  "text": "A世界：你年入5万，别人[2.5万]"
 },
 {
  "start": 57,
  "end": 61.1,
  "text": "B世界：你年入10万，别人[20万]"
 },
 {
  "start": 61.1,
  "end": 65.1,
  "text": "B多挣一倍，可[48%]的人选了A"
 },
 {
  "start": 65.2,
  "end": 69.2,
  "text": "换成假期呢？[85%]的人只要自己多"
 },
 {
  "start": 69.2,
  "end": 73.2,
  "text": "原来我们，偏偏在[钱]上最爱比"
 },
 {
  "start": 73.2,
  "end": 77.2,
  "text": "2008年，一家报纸把加州大学的工资[放上了网]"
 },
 {
  "start": 77.2,
  "end": 81.3,
  "text": "研究者提醒一部分员工：[可以去查同事]"
 },
 {
  "start": 81.4,
  "end": 85.4,
  "text": "低于中位数的人：满意度[下降]"
 },
 {
  "start": 85.4,
  "end": 89.5,
  "text": "而且[更想跳槽]"
 },
 {
  "start": 89.5,
  "end": 93.5,
  "text": "高于中位数的人呢？[并没有更开心]"
 },
 {
  "start": 93.5,
  "end": 97.6,
  "text": "比较这笔账，只有[比输的人]在痛"
 },
 {
  "start": 97.6,
  "end": 101.6,
  "text": "还有研究发现：自己收入不变，[邻居]挣得越多"
 },
 {
  "start": 101.6,
  "end": 105.7,
  "text": "人就[越不快乐]"
 },
 {
  "start": 105.7,
  "end": 109.7,
  "text": "所以觉得穷，不一定是[钱少]"
 },
 {
  "start": 109.7,
  "end": 113.8,
  "text": "是你身边，总有一颗[葡萄]"
 },
 {
  "start": 113.8,
  "end": 117.8,
  "text": "比较是天性，但[跟谁比]，你能选"
 },
 {
  "start": 117.8,
  "end": 121.9,
  "text": "跟去年的自己比，你[多了4000]"
 },
 {
  "start": 121.9,
  "end": 125.4,
  "text": "你最常拿自己，跟[谁]比？"
 }
]