[
 {
  "start": 0.0,
  "end": 3.15,
  "text": "这颗彗星，你这辈子多半只见一次"
 },
 {
  "start": 3.25,
  "end": 5.83,
  "text": "它平均[76]年，才回来一次"
 },
 {
  "start": 5.93,
  "end": 8.51,
  "text": "1705年，天文学家哈雷写下"
 },
 {
  "start": 8.61,
  "end": 11.33,
  "text": "我斗胆预言：[1758]年它会回来"
 },
 {
  "start": 11.43,
  "end": 14.01,
  "text": "可到那一年，他该[102]岁了"
 },
 {
  "start": 14.11,
  "end": 16.4,
  "text": "要等[53]年，才有答案"
 },
 {
  "start": 20.8,
  "end": 23.84,
  "text": "如果彗星绕太阳转圈，就会回来"
 },
 {
  "start": 23.94,
  "end": 26.84,
  "text": "哈雷翻出[24]颗彗星的旧记录"
 },
 {
  "start": 26.94,
  "end": 29.84,
  "text": "用牛顿的引力，逐个算出轨道"
 },
 {
  "start": 29.94,
  "end": 32.55,
  "text": "其中三颗，轨道几乎一样"
 },
 {
  "start": 32.65,
  "end": 34.96,
  "text": "1531、1607、1682年"
 },
 {
  "start": 35.06,
  "end": 37.67,
  "text": "不是三颗彗星，是[同一颗]"
 },
 {
  "start": 37.77,
  "end": 40.53,
  "text": "那就能算：它下次哪年回来"
 },
 {
  "start": 40.63,
  "end": 43.24,
  "text": "可间隔不等：76年，又75年"
 },
 {
  "start": 43.34,
  "end": 46.24,
  "text": "他的解释：[木星]的引力在拉它"
 },
 {
  "start": 46.34,
  "end": 48.95,
  "text": "他预计：1758年底到次年初"
 },
 {
  "start": 49.1,
  "end": 51.63,
  "text": "1742年，哈雷去世，没等到"
 },
 {
  "start": 51.73,
  "end": 54.55,
  "text": "巴黎，三个人重算它的归期"
 },
 {
  "start": 54.65,
  "end": 57.61,
  "text": "这次，把木星和土星都算进去"
 },
 {
  "start": 57.71,
  "end": 60.81,
  "text": "拉朗德回忆：六个月，从早算到晚"
 },
 {
  "start": 60.91,
  "end": 63.15,
  "text": "有时吃饭，也在算"
 },
 {
  "start": 63.25,
  "end": 66.34,
  "text": "比起没有行星，木星让它晚[518]天"
 },
 {
  "start": 66.44,
  "end": 68.82,
  "text": "土星再让它晚[100]天"
 },
 {
  "start": 68.92,
  "end": 71.15,
  "text": "加起来，晚了[618]天"
 },
 {
  "start": 71.25,
  "end": 74.34,
  "text": "他们算出它最接近太阳的日子"
 },
 {
  "start": 74.44,
  "end": 77.25,
  "text": "[1759年4月中旬]，前后一个月"
 },
 {
  "start": 77.35,
  "end": 79.3,
  "text": "它会回来吗？"
 },
 {
  "start": 81.45,
  "end": 83.64,
  "text": "[1758年12月25日]夜"
 },
 {
  "start": 83.74,
  "end": 86.93,
  "text": "一位业余观星的农民，先看到了它"
 },
 {
  "start": 87.03,
  "end": 89.51,
  "text": "这时，哈雷已去世[16]年"
 },
 {
  "start": 89.61,
  "end": 92.23,
  "text": "3月13日，它离太阳最近"
 },
 {
  "start": 92.33,
  "end": 95.09,
  "text": "比他们算的，早了[约一个月]"
 },
 {
  "start": 95.19,
  "end": 97.38,
  "text": "其实，它早就来过"
 },
 {
  "start": 97.48,
  "end": 100.53,
  "text": "能确认的最早记录：公元前[240]年"
 },
 {
  "start": 100.63,
  "end": 103.53,
  "text": "此后，中国史书几乎次次记下"
 },
 {
  "start": 103.63,
  "end": 106.53,
  "text": "但它一圈，最短[74]年，最长[79]年"
 },
 {
  "start": 106.63,
  "end": 109.39,
  "text": "行星一拉，每一圈都得重算"
 },
 {
  "start": 109.49,
  "end": 111.54,
  "text": "下一次，在[2061]年"
 },
 {
  "start": 111.64,
  "end": 114.4,
  "text": "哈雷没等到的，这次[轮到你]"
 }
]