[
 {
  "start": 0.0,
  "end": 3.63,
  "text": "这颗彗星，你这辈子多半只见一次"
 },
 {
  "start": 3.73,
  "end": 7.22,
  "text": "预言它回来的人，那年该[102]岁了"
 },
 {
  "start": 7.32,
  "end": 10.38,
  "text": "1705年，天文学家哈雷写道"
 },
 {
  "start": 10.48,
  "end": 13.54,
  "text": "「斗胆预言：[1758]年它会回来」"
 },
 {
  "start": 13.64,
  "end": 16.4,
  "text": "要等[53]年，才有答案"
 },
 {
  "start": 20.8,
  "end": 24.45,
  "text": "如果彗星绕太阳转圈，就会回来"
 },
 {
  "start": 24.55,
  "end": 28.34,
  "text": "他用牛顿引力，算出[24]颗彗星轨道"
 },
 {
  "start": 28.44,
  "end": 31.66,
  "text": "其中三颗，轨道几乎一样"
 },
 {
  "start": 31.76,
  "end": 34.98,
  "text": "不是三颗彗星，是[同一颗]"
 },
 {
  "start": 35.08,
  "end": 38.44,
  "text": "那就能算：它下次哪年回来"
 },
 {
  "start": 38.54,
  "end": 41.76,
  "text": "可间隔不等：76年，又75年"
 },
 {
  "start": 41.86,
  "end": 45.36,
  "text": "他的解释：[木星]的引力在拉它"
 },
 {
  "start": 45.46,
  "end": 48.95,
  "text": "所以他估计：1758年底到次年初"
 },
 {
  "start": 49.1,
  "end": 52.04,
  "text": "1742年，哈雷去世，没等到"
 },
 {
  "start": 52.14,
  "end": 55.65,
  "text": "巴黎：克莱罗、拉朗德、勒波特夫人"
 },
 {
  "start": 55.75,
  "end": 59.4,
  "text": "三人接力，把木星和土星都算进去"
 },
 {
  "start": 59.5,
  "end": 63.15,
  "text": "六个月从早算到晚，有时边吃边算"
 },
 {
  "start": 63.25,
  "end": 67.91,
  "text": "木星让这一圈，比上一圈晚[518]天"
 },
 {
  "start": 68.01,
  "end": 72.39,
  "text": "加上土星，比上一圈晚[618]天"
 },
 {
  "start": 72.49,
  "end": 77.15,
  "text": "预测[1759年4月中旬]最接近太阳"
 },
 {
  "start": 77.25,
  "end": 79.3,
  "text": "它会回来吗？"
 },
 {
  "start": 81.45,
  "end": 83.86,
  "text": "[1758年12月25日]夜"
 },
 {
  "start": 83.96,
  "end": 87.37,
  "text": "它回来了。先看到它的，是一位农民"
 },
 {
  "start": 87.47,
  "end": 90.17,
  "text": "这时，哈雷已去世[16]年"
 },
 {
  "start": 90.27,
  "end": 93.25,
  "text": "1759年3月13日，最接近太阳"
 },
 {
  "start": 93.35,
  "end": 96.91,
  "text": "比预测早了约一个月，卡在误差边上"
 },
 {
  "start": 97.01,
  "end": 100.28,
  "text": "能确认的最早记录：公元前[240]年"
 },
 {
  "start": 100.38,
  "end": 103.51,
  "text": "此后，中国史书几乎次次记下"
 },
 {
  "start": 103.61,
  "end": 106.74,
  "text": "可它并不准点：一圈[74]到[79]年"
 },
 {
  "start": 106.84,
  "end": 110.11,
  "text": "所以下一次，也是这样算出来的"
 },
 {
  "start": 110.21,
  "end": 112.62,
  "text": "算出的答案：[2061]年"
 },
 {
  "start": 112.72,
  "end": 115.7,
  "text": "哈雷没等到的，这次[轮到你]"
 }
]