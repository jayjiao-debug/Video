[[0.6, 3.0, "路边，一只猫被车撞了"], [3.1, 5.5, "很多人会难过一整天"], [5.6, 7.9, "2018年，肯尼亚"], [8.0, 11.4, "最后一只雄性北方白犀牛死了"], [11.5, 13.6, "它叫苏丹，45岁"], [13.7, 16.9, "全世界都为它难过"], [17.0, 19.5, "一只苍蝇落在窗台上"], [19.6, 22.3, "一巴掌，没人会多看一眼"], [22.4, 24.3, "苍蝇、猫、犀牛"], [24.4, 26.6, "都是一条命"], [27.0, 29.9, "为什么心疼的程度，差这么多？"], [30.0, 32.9, "是我们太冷血了吗？"], [33.0, 35.7, "法国研究者问了三千多人"], [35.8, 39.0, "两种生物，只能救一个，你救谁？"], [39.1, 42.2, "结果，藏着一个规律"], [45.4, 47.8, "和人类越近，越被同情"], [47.9, 50.3, "我们心里有一把尺子"], [50.4, 52.7, "刻度是：像不像我们"], [52.8, 56.1, "两千多年前，庄子在桥上看鱼"], [56.2, 58.3, "他说：鱼真快乐"], [58.4, 60.9, "朋友惠子问：你又不是鱼"], [61.0, 63.8, "怎么知道鱼快乐？"], [63.9, 66.3, "1974年，哲学家内格尔问"], [66.4, 69.0, "做一只蝙蝠，是什么感觉？"], [69.1, 72.2, "我们永远进不到别的生命里面"], [72.3, 75.3, "只能用“像不像我”，猜它疼不疼"], [75.4, 78.5, "所以猫让人心疼，苍蝇不会"], [78.6, 84.5, "那么，这条线该画在哪里？"], [84.6, 86.9, "康德说：画在“会思考”"], [87.0, 89.9, "只有会思考的人，才真正算数"], [90.0, 92.5, "动物不在线里面"], [92.6, 95.2, "可他也说：对动物狠的人"], [95.3, 97.7, "对人，也会变得冷酷"], [97.8, 100.0, "边沁说：画在“会不会痛”"], [100.1, 103.3, "问题不是它能不能思考、说话"], [103.4, 106.0, "而是：它会不会痛苦"], [106.1, 109.2, "1975年，辛格写下《动物解放》"], [109.3, 112.3, "同样的痛苦，就该同样地在乎"], [112.4, 115.5, "鸡的痛，和狗的痛，一样重"], [115.6, 118.1, "只因为不是人，就不算数"], [118.2, 120.4, "他把这叫作：物种歧视"], [120.5, 123.3, "就像种族歧视、性别歧视"], [123.4, 126.2, "史怀哲说：画在“活着”本身"], [126.3, 128.8, "1915年，非洲的一条河上"], [128.9, 131.1, "船穿过一群河马"], [131.2, 134.3, "他心里冒出四个字：敬畏生命"], [134.4, 136.8, "我是希望活下去的生命"], [136.9, 139.9, "活在同样希望活下去的生命之中"], [140.0, 142.3, "他拒绝给生命排高低"], [142.4, 144.6, "活着，免不了伤害"], [144.7, 147.0, "但不该毫无必要"], [147.1, 149.5, "1869年，历史学家莱基写道"], [149.6, 152.2, "人的善意，最先只给家人"], [152.3, 154.8, "后来是阶层、国家、全人类"], [154.9, 157.0, "最后，才轮到动物"], [157.1, 159.5, "所以，生命平等吗？"], [159.6, 162.3, "在我们心里，从来不平等"], [162.4, 166.4, "但这个圈，一直在变大"], [167.9, 170.2, "苏丹让全世界难过"], [170.3, 173.0, "不是因为它的命比苍蝇更重"], [173.1, 175.7, "是因为我们看见了它"], [175.8, 177.9, "天地与我并生"], [178.0, 180.8, "而万物与我为一"]]