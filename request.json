  {
   "name": "y01",
   "lang": "zh",
   "text": "他酒喝到一半，起身去上厕所，就再也没回来。",
   "model": "eleven_v4",
   "settings": {
    "stability": 0.2,
    "similarity_boost": 0.8,
    "style": 0.75,
