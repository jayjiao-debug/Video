   },
   "lines": [
    {
     "text": "[amazed] 一个学生都没有。",
     "voice": {
      "owner": "8ef98e23c1198e4a1eddd0480344160e4f2dce44147dfc18c034756c42071e4a",
      "voice_id": "I23uc91tu5zY2PA1tKEN",
      "name": "Lin"
     }
    },
    {
     "text": "[dry, unbothered] The walls never miss a lecture.",
     "voice": {
      "owner": "9d48e632126e47fa24331617611c4fab3fbb61beadec42067817c28ade5f332f",
      "voice_id": "dUercWozs0yhe4xBCgZ0",
      "name": "Mandrake"
     }
    },
    {
     "text": "[cheeky] 墙听得懂吗？",
     "voice": {
      "owner": "8ef98e23c1198e4a1eddd0480344160e4f2dce44147dfc18c034756c42071e4a",
      "voice_id": "I23uc91tu5zY2PA1tKEN",
      "name": "Lin"
     }
    },
    {
     "text": "[deadpan] As well as the students.",
     "voice": {
      "owner": "9d48e632126e47fa24331617611c4fab3fbb61beadec42067817c28ade5f332f",
      "voice_id": "dUercWozs0yhe4xBCgZ0",
      "name": "Mandrake"
     }
    },
    {
     "text": "[laughing] 他没笑，我笑了。",
     "voice": {
      "owner": "8ef98e23c1198e4a1eddd0480344160e4f2dce44147dfc18c034756c42071e4a",
      "voice_id": "I23uc91tu5zY2PA1tKEN",
      "name": "Lin"
     }
    },
    {
     "text": "[flat] Don't.",
     "voice": {
      "owner": "9d48e632126e47fa24331617611c4fab3fbb61beadec42067817c28ade5f332f",
      "voice_id": "dUercWozs0yhe4xBCgZ0",
      "name": "Mandrake"
     }
    }
   ]
