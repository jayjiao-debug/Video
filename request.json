   "settings": {
    "stability": 0.5
   },
   "lines": [
    {
     "text": "[bright, eager] 早上好！今天陪您过一天！",
     "voice": {
      "owner": "8ef98e23c1198e4a1eddd0480344160e4f2dce44147dfc18c034756c42071e4a",
      "voice_id": "I23uc91tu5zY2PA1tKEN",
      "name": "Lin"
     }
    },
    {
     "text": "[flat, matter-of-fact] Good night.",
     "voice": {
      "owner": "9d48e632126e47fa24331617611c4fab3fbb61beadec42067817c28ade5f332f",
      "voice_id": "dUercWozs0yhe4xBCgZ0",
      "name": "Mandrake"
     }
    },
    {
     "text": "[baffled, amused] 他这是……刚要睡？",
     "voice": {
      "owner": "8ef98e23c1198e4a1eddd0480344160e4f2dce44147dfc18c034756c42071e4a",
      "voice_id": "I23uc91tu5zY2PA1tKEN",
      "name": "Lin"
     }
    },
    {
     "text": "[friendly, curious] 助手小哥，他平时笑吗？",
     "voice": {
      "owner": "8ef98e23c1198e4a1eddd0480344160e4f2dce44147dfc18c034756c42071e4a",
      "voice_id": "I23uc91tu5zY2PA1tKEN",
      "name": "Lin"
     }
    },
    {
     "text": "[startled, incredulous] Laugh? Mr Newton?",
     "voice": {
      "owner": "333250518273b1daa7efac81d613e82401a57b4749951a5f22c1dd136fde494b",
      "voice_id": "pYDLV125o4CgqP8i49Lg",
      "name": "Toby"
     }
    },
    {
     "text": "[fired up, cheeky] 好，今天我要让他笑一次。",
     "voice": {
      "owner": "8ef98e23c1198e4a1eddd0480344160e4f2dce44147dfc18c034756c42071e4a",
      "voice_id": "I23uc91tu5zY2PA1tKEN",
      "name": "Lin"
     }
    }
   ]
  },
