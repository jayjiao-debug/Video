 "id": "qin-vo-fix-01",
 "items": [
  {
   "type": "dialogue",
   "name": "dlg_G_s4242",
   "lang": "zh",
   "model": "eleven_v4",
   "seed": 4242,
   "settings": {
    "stability": 0.5
   },
   "lines": [
    {
     "text": "[softly, hopeful] 陛下？今天……还拍吗？",
     "voice": {
      "owner": "8ef98e23c1198e4a1eddd0480344160e4f2dce44147dfc18c034756c42071e4a",
      "voice_id": "I23uc91tu5zY2PA1tKEN",
      "name": "Lin"
     }
    },
    {
     "text": "[thin, flat] 准。",
     "voice": {
      "owner": "5c5962287b218047405eda9089bab96b2b24534c3e0fe1be105b6168cf79c324",
      "voice_id": "AAYMKjNBrET5q9uPiIQS",
      "name": "ZeyuLiu"
     }
    },
    {
     "text": "[thin, flat] 准。",
     "voice": {
      "owner": "5c5962287b218047405eda9089bab96b2b24534c3e0fe1be105b6168cf79c324",
      "voice_id": "AAYMKjNBrET5q9uPiIQS",
      "name": "ZeyuLiu"
     }
    },
    {
     "text": "[quiet, sad] 那年夏天，陛下死在了出巡的路上。丞相瞒住了消息，百官每天照样往车里递奏章。",
     "voice": {
      "owner": "8ef98e23c1198e4a1eddd0480344160e4f2dce44147dfc18c034756c42071e4a",
      "voice_id": "I23uc91tu5zY2PA1tKEN",
      "name": "Lin"
     }
    },
    {
     "text": "[quiet] 天太热，车里有了臭味。他们就往车上装了咸鱼，盖住味道。",
     "voice": {
      "owner": "8ef98e23c1198e4a1eddd0480344160e4f2dce44147dfc18c034756c42071e4a",
      "voice_id": "I23uc91tu5zY2PA1tKEN",
      "name": "Lin"
     }
    },
    {
     "text": "[quiet, wistful] 陛下一直，想长生不老。",
     "voice": {
      "owner": "8ef98e23c1198e4a1eddd0480344160e4f2dce44147dfc18c034756c42071e4a",
      "voice_id": "I23uc91tu5zY2PA1tKEN",
      "name": "Lin"
     }
    },
    {
     "text": "[gentle] 他没活过五十岁。可他的兵马俑，站了两千多年。",
     "voice": {
      "owner": "8ef98e23c1198e4a1eddd0480344160e4f2dce44147dfc18c034756c42071e4a",
      "voice_id": "I23uc91tu5zY2PA1tKEN",
      "name": "Lin"
     }
    },
    {
     "text": "[off-screen, weak, gentle] 这段，也删了。",
     "voice": {
      "owner": "adc9f3ee76562072a32fad7d72edc6b3e523b1628c749f160e836396cd54ef0e",
      "voice_id": "pU9NaAwkoR3v0Mrg3uKz",
      "name": "Haoran"
     }
    },
    {
     "text": "[soft laugh, teary] 不删。",
     "voice": {
      "owner": "8ef98e23c1198e4a1eddd0480344160e4f2dce44147dfc18c034756c42071e4a",
      "voice_id": "I23uc91tu5zY2PA1tKEN",
      "name": "Lin"
     }
    }
   ]
  },
