     }
    },
    {
     "text": "[protesting] 现在才早上……",
     "voice": {
      "owner": "8ef98e23c1198e4a1eddd0480344160e4f2dce44147dfc18c034756c42071e4a",
      "voice_id": "I23uc91tu5zY2PA1tKEN",
      "name": "Lin"
     }
    },
    {
     "text": "[very pleased with himself] 早上喝的，叫早酒。",
     "voice": {
      "owner": "58791ad7bc6d818a68e8981ab4ccea600a45458a5e4c8c1d032528f2b8c3e6a1",
      "voice_id": "mZc8T5doZrU7OCI71i3M",
      "name": "HanBaba"
     }
    },
    {
     "text": "[curious] 您昨晚喝了多少啊？",
     "voice": {
      "owner": "8ef98e23c1198e4a1eddd0480344160e4f2dce44147dfc18c034756c42071e4a",
      "voice_id": "I23uc91tu5zY2PA1tKEN",
      "name": "Lin"
     }
    },
    {
     "text": "[counting on fingers, then shrugging, pleased] 不多。一日须倾三百杯嘛。",
     "voice": {
      "owner": "58791ad7bc6d818a68e8981ab4ccea600a45458a5e4c8c1d032528f2b8c3e6a1",
      "voice_id": "mZc8T5doZrU7OCI71i3M",
      "name": "HanBaba"
     }
    },
    {
     "text": "[to camera, deadpan] 他把自己的诗，当说明书用。",
     "voice": {
      "owner": "8ef98e23c1198e4a1eddd0480344160e4f2dce44147dfc18c034756c42071e4a",
      "voice_id": "I23uc91tu5zY2PA1tKEN",
