  {
   "name": "v7_11",
   "lang": "zh",
   "voice_id": "APSIkVZudNbPAwyPoeVO",
   "model": "eleven_v4",
   "settings": {
    "stability": 0.5,
    "similarity_boost": 0.8,
    "style": 0.3,
    "speed": 1.08
   },
   "text": "你猜，它卖了多少？"
