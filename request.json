  {
   "type": "dialogue",
   "name": "v4_S3_s1686",
   "model": "eleven_v4",
   "seed": 1686,
   "settings": {
    "stability": 0.5
   },
   "lines": [
    {
     "text": "[cheeky, a bit rude] 您从来不出去玩吗？",
     "voice": {
      "owner": "8ef98e23c1198e4a1eddd0480344160e4f2dce44147dfc18c034756c42071e4a",
      "voice_id": "I23uc91tu5zY2PA1tKEN",
      "name": "Lin"
     }
    },
    {
     "text": "[dry, literal] I am out.",
     "voice": {
      "owner": "9d48e632126e47fa24331617611c4fab3fbb61beadec42067817c28ade5f332f",
      "voice_id": "dUercWozs0yhe4xBCgZ0",
      "name": "Mandrake"
     }
    },
    {
     "text": "[teasing] 绕两圈就算玩？",
     "voice": {
      "owner": "8ef98e23c1198e4a1eddd0480344160e4f2dce44147dfc18c034756c42071e4a",
      "voice_id": "I23uc91tu5zY2PA1tKEN",
      "name": "Lin"
     }
    },
    {
     "text": "[lecturing, then cut off] Two laps is—",
     "voice": {
      "owner": "9d48e632126e47fa24331617611c4fab3fbb61beadec42067817c28ade5f332f",
      "voice_id": "dUercWozs0yhe4xBCgZ0",
      "name": "Mandrake"
     }
    },
    {
     "text": "[startled, curious] 诶？他想到什么了？",
     "voice": {
      "owner": "8ef98e23c1198e4a1eddd0480344160e4f2dce44147dfc18c034756c42071e4a",
      "voice_id": "I23uc91tu5zY2PA1tKEN",
      "name": "Lin"
     }
    },
    {
     "text": "[amused, coaxing] 坐下写嘛。",
     "voice": {
      "owner": "8ef98e23c1198e4a1eddd0480344160e4f2dce44147dfc18c034756c42071e4a",
      "voice_id": "I23uc91tu5zY2PA1tKEN",
      "name": "Lin"
     }
    },
    {
     "text": "[absorbed, dismissive] No time.",
     "voice": {
      "owner": "9d48e632126e47fa24331617611c4fab3fbb61beadec42067817c28ade5f332f",
      "voice_id": "dUercWozs0yhe4xBCgZ0",
      "name": "Mandrake"
     }
    }
   ]
  },
