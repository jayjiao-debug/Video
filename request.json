  {
   "type": "dialogue",
   "name": "v4_S2_s1686",
   "model": "eleven_v4",
   "seed": 1686,
   "settings": {
    "stability": 0.5
   },
   "lines": [
    {
     "text": "[polite, hopeful] Sir, your dinner.",
     "voice": {
      "owner": "333250518273b1daa7efac81d613e82401a57b4749951a5f22c1dd136fde494b",
      "voice_id": "pYDLV125o4CgqP8i49Lg",
      "name": "Toby"
     }
    },
    {
     "text": "[calling out, helpful] 他说马上来！",
     "voice": {
      "owner": "8ef98e23c1198e4a1eddd0480344160e4f2dce44147dfc18c034756c42071e4a",
      "voice_id": "I23uc91tu5zY2PA1tKEN",
      "name": "Lin"
     }
    },
    {
     "text": "[lively] 牛顿先生，您在写什么？",
     "voice": {
      "owner": "8ef98e23c1198e4a1eddd0480344160e4f2dce44147dfc18c034756c42071e4a",
      "voice_id": "I23uc91tu5zY2PA1tKEN",
      "name": "Lin"
     }
    },
    {
     "text": "[dry, distracted] An answer. The astronomer Halley asked how planets go round the Sun.",
     "voice": {
      "owner": "9d48e632126e47fa24331617611c4fab3fbb61beadec42067817c28ade5f332f",
      "voice_id": "dUercWozs0yhe4xBCgZ0",
      "name": "Mandrake"
     }
    },
    {
     "text": "[teasing] 一个问题，写这么厚？",
     "voice": {
      "owner": "8ef98e23c1198e4a1eddd0480344160e4f2dce44147dfc18c034756c42071e4a",
      "voice_id": "I23uc91tu5zY2PA1tKEN",
      "name": "Lin"
     }
    },
    {
     "text": "[dry, absorbed] I lost the first one. Began again.",
     "voice": {
      "owner": "9d48e632126e47fa24331617611c4fab3fbb61beadec42067817c28ade5f332f",
      "voice_id": "dUercWozs0yhe4xBCgZ0",
      "name": "Mandrake"
     }
    },
    {
     "text": "[cheeky] 是苹果砸头那个吗？",
     "voice": {
      "owner": "8ef98e23c1198e4a1eddd0480344160e4f2dce44147dfc18c034756c42071e4a",
      "voice_id": "I23uc91tu5zY2PA1tKEN",
      "name": "Lin"
     }
    },
    {
     "text": "[cold, precise] It fell to the ground. Not on me.",
     "voice": {
      "owner": "9d48e632126e47fa24331617611c4fab3fbb61beadec42067817c28ade5f332f",
      "voice_id": "dUercWozs0yhe4xBCgZ0",
      "name": "Mandrake"
     }
    },
    {
     "text": "[deadpan] 没笑。",
     "voice": {
      "owner": "8ef98e23c1198e4a1eddd0480344160e4f2dce44147dfc18c034756c42071e4a",
      "voice_id": "I23uc91tu5zY2PA1tKEN",
      "name": "Lin"
     }
    }
   ]
  },
