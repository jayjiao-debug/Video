 ],
 "items": [
  {
   "name": "k01",
   "lang": "zh",
   "voice_id": "5mZxJZhSmJTjL7GoYfYI",
   "settings": {
    "stability": 0.2,
    "similarity_boost": 0.8,
    "style": 0.75,
    "speed": 1.2,
    "use_speaker_boost": true
   },
   "text": "他把刚拔出来的石中剑，又插了回去。"
  },
  {
   "name": "k02",
   "lang": "zh",
   "voice_id": "5mZxJZhSmJTjL7GoYfYI",
   "settings": {
    "stability": 0.2,
    "similarity_boost": 0.8,
    "style": 0.75,
    "speed": 1.2,
    "use_speaker_boost": true
   },
   "text": "等等，拔出来不就是国王吗？"
  },
  {
   "name": "k03",
   "lang": "zh",
   "voice_id": "5mZxJZhSmJTjL7GoYfYI",
   "settings": {
    "stability": 0.2,
    "similarity_boost": 0.8,
    "style": 0.75,
    "speed": 1.2,
    "use_speaker_boost": true
   },
   "text": "名著《亚瑟王之死》里，伦敦教堂院子里多了块大石头，插着把剑。"
  },
  {
   "name": "k04",
   "lang": "zh",
   "voice_id": "5mZxJZhSmJTjL7GoYfYI",
   "settings": {
    "stability": 0.2,
    "similarity_boost": 0.8,
    "style": 0.75,
    "speed": 1.2,
    "use_speaker_boost": true
   },
   "text": "金字写着：谁拔出来，谁就是国王。"
  },
  {
   "name": "k05",
   "lang": "zh",
   "voice_id": "5mZxJZhSmJTjL7GoYfYI",
   "settings": {
    "stability": 0.2,
    "similarity_boost": 0.8,
    "style": 0.75,
    "speed": 1.2,
    "use_speaker_boost": true
   },
   "text": "贵族排队来拔，脸都憋红了，剑一动不动。"
  },
  {
   "name": "k06",
   "lang": "zh",
   "voice_id": "5mZxJZhSmJTjL7GoYfYI",
   "settings": {
    "stability": 0.2,
    "similarity_boost": 0.8,
    "style": 0.75,
    "speed": 1.2,
    "use_speaker_boost": true
   },
   "text": "新年比武大会，亚瑟的哥哥叫凯，刚当上骑士，一摸腰，剑忘带了。"
  },
  {
   "name": "k07",
   "lang": "zh",
   "voice_id": "5mZxJZhSmJTjL7GoYfYI",
   "settings": {
    "stability": 0.2,
    "similarity_boost": 0.8,
    "style": 0.75,
    "speed": 1.2,
    "use_speaker_boost": true
   },
   "text": "亚瑟回去拿，家里没人，全看比武去了。"
  },
  {
   "name": "k08",
   "lang": "zh",
   "voice_id": "5mZxJZhSmJTjL7GoYfYI",
   "settings": {
    "stability": 0.2,
    "similarity_boost": 0.8,
    "style": 0.75,
    "speed": 1.2,
    "use_speaker_boost": true
   },
   "text": "他想起石头上还插着一把。"
  },
  {
   "name": "k09",
   "lang": "zh",
   "voice_id": "5mZxJZhSmJTjL7GoYfYI",
   "settings": {
    "stability": 0.2,
    "similarity_boost": 0.8,
    "style": 0.75,
    "speed": 1.2,
    "use_speaker_boost": true
   },
   "text": "连十个守卫都看比武去了，他一拔就出来，第一次。"
  },
  {
   "name": "k10",
   "lang": "zh",
   "voice_id": "5mZxJZhSmJTjL7GoYfYI",
   "settings": {
    "stability": 0.2,
    "similarity_boost": 0.8,
    "style": 0.75,
    "speed": 1.2,
    "use_speaker_boost": true
   },
   "text": "凯拿到剑就找爸爸：“爸，石中剑！我要当国王了！”"
  },
  {
   "name": "k11",
   "lang": "zh",
   "voice_id": "5mZxJZhSmJTjL7GoYfYI",
   "settings": {
    "stability": 0.2,
    "similarity_boost": 0.8,
    "style": 0.75,
    "speed": 1.2,
    "use_speaker_boost": true
   },
   "text": "爸爸让他发誓，凯才承认是弟弟拿的。"
  },
  {
   "name": "k12",
   "lang": "zh",
   "voice_id": "5mZxJZhSmJTjL7GoYfYI",
   "settings": {
    "stability": 0.2,
    "similarity_boost": 0.8,
    "style": 0.75,
    "speed": 1.2,
    "use_speaker_boost": true
   },
   "text": "爸爸让亚瑟插回去再拔一次，他说：“这有什么难的。”"
  },
  {
   "name": "k13",
   "lang": "zh",
   "voice_id": "5mZxJZhSmJTjL7GoYfYI",
   "settings": {
    "stability": 0.2,
    "similarity_boost": 0.8,
    "style": 0.75,
    "speed": 1.2,
    "use_speaker_boost": true
   },
   "text": "爸爸先拔，不动；凯使出吃奶的劲，不动；亚瑟一伸手，第二次。"
  },
  {
   "name": "k14",
   "lang": "zh",
   "voice_id": "5mZxJZhSmJTjL7GoYfYI",
   "settings": {
    "stability": 0.2,
    "similarity_boost": 0.8,
    "style": 0.75,
    "speed": 1.2,
    "use_speaker_boost": true
   },
   "text": "几天后贵族全来试，只有他拔得出，第三次。"
  },
  {
   "name": "k15",
   "lang": "zh",
   "voice_id": "5mZxJZhSmJTjL7GoYfYI",
   "settings": {
    "stability": 0.2,
    "similarity_boost": 0.8,
    "style": 0.75,
    "speed": 1.2,
    "use_speaker_boost": true
   },
   "text": "他们气炸了：“让个出身不高的小子管我们？”说改天再拔。"
  },
  {
   "name": "k16",
   "lang": "zh",
   "voice_id": "5mZxJZhSmJTjL7GoYfYI",
   "settings": {
    "stability": 0.2,
    "similarity_boost": 0.8,
    "style": 0.75,
    "speed": 1.2,
    "use_speaker_boost": true
   },
   "text": "二月，雪还没化，第四次，又拖。"
  },
  {
   "name": "k17",
   "lang": "zh",
   "voice_id": "5mZxJZhSmJTjL7GoYfYI",
   "settings": {
    "stability": 0.2,
    "similarity_boost": 0.8,
    "style": 0.75,
    "speed": 1.2,
    "use_speaker_boost": true
   },
   "text": "春天，花都开了，第五次，还拖。"
  },
  {
   "name": "k18",
   "lang": "zh",
   "voice_id": "5mZxJZhSmJTjL7GoYfYI",
   "settings": {
    "stability": 0.2,
    "similarity_boost": 0.8,
    "style": 0.75,
    "speed": 1.2,
    "use_speaker_boost": true
   },
   "text": "初夏，当着所有人的面，第六次。"
  },
  {
   "name": "k19",
   "lang": "zh",
   "voice_id": "5mZxJZhSmJTjL7GoYfYI",
   "settings": {
    "stability": 0.2,
    "similarity_boost": 0.8,
    "style": 0.75,
    "speed": 1.2,
    "use_speaker_boost": true
   },
   "text": "老百姓急了：“就要亚瑟当国王，别再拖了！”"
  },
  {
   "name": "k20",
   "lang": "zh",
   "voice_id": "5mZxJZhSmJTjL7GoYfYI",
   "settings": {
    "stability": 0.2,
    "similarity_boost": 0.8,
    "style": 0.75,
    "speed": 1.2,
    "use_speaker_boost": true
   },
   "text": "所有人齐刷刷跪下。"
  },
  {
   "name": "k21",
   "lang": "zh",
   "voice_id": "5mZxJZhSmJTjL7GoYfYI",
   "settings": {
    "stability": 0.2,
    "similarity_boost": 0.8,
    "style": 0.75,
    "speed": 1.2,
    "use_speaker_boost": true
   },
   "text": "整整六次，他才当上国王，而第一次，只因为哥哥忘了带剑。"
  },
